@model BookifyHotel.Model.Room
@{
    ViewData["Title"] = "Room Details";
    Layout = "~/Views/Shared/_SideBarLayout.cshtml";
}

<body data-active-page="rooms">
    <div class="header">
        <h2>Room Details</h2>
        <div class="user-info">
            <div>
                <h4>System Administrator</h4>
                <p style="color: #b8860b;">Admin</p>
            </div>
            <img src="https://ui-avatars.com/api/?name=Admin&background=b8860b&color=fff" alt="User">
        </div>
    </div>

    <!-- Back Button -->
    <a href="@Url.Action("Index2", "Room")" class="back-btn">
        <i class="fas fa-arrow-left"></i>
        Back to Rooms
    </a>

    @if (Model != null)
    {
        <div class="details-container">
            <!-- Room Image Section -->
            <div class="room-image-section">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="Room @Model.RoomNumber" class="room-main-image">
                }
                else
                {
                    <div class="image-placeholder">
                        <i class="fas fa-door-open"></i>
                    </div>
                }
                <div class="detail-item">
                    <div class="detail-label">Room Image</div>
                    <div class="detail-value">
                        <i class="fas fa-camera"></i>
                        @(string.IsNullOrEmpty(Model.ImageUrl) ? "No Image Available" : "Image Available")
                    </div>
                </div>
            </div>

            <!-- Room Info Section -->
            <div class="room-info-section">
                <div class="room-header">
                    <div class="room-title">
                        <h1>Room @Model.RoomNumber</h1>
                        <div class="room-type">@(Model.RoomTypes?.Name ?? "Undefined Type")</div>
                    </div>
                    <div class="room-status @(Model.IsAvailable ? "available" : "occupied")">
                        @(Model.IsAvailable ? "Available" : "Occupied")
                    </div>
                </div>

                <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Room ID</div>
                        <div class="detail-value">
                            <i class="fas fa-hashtag"></i>
                            @Model.RoomId
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Floor</div>
                        <div class="detail-value">
                            <i class="fas fa-building"></i>
                            Floor @Model.Floor
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Status</div>
                        <div class="detail-value">
                            <i class="fas fa-info-circle"></i>
                            @Model.Status
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Room Type ID</div>
                        <div class="detail-value">
                            <i class="fas fa-tag"></i>
                            @Model.RoomTypeId
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Total Bookings</div>
                        <div class="detail-value">
                            <i class="fas fa-calendar-check"></i>
                            @(Model.Bookings?.Count ?? 0) Bookings
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Availability</div>
                        <div class="detail-value">
                            <i class="fas @(Model.IsAvailable ? "fa-check-circle" : "fa-times-circle")"></i>
                            @(Model.IsAvailable ? "Available for Booking" : "Not Available")
                        </div>
                    </div>
                </div>

                <!-- Room Type Information -->
                <div class="room-type-info">
                    <h3>Room Type Information</h3>
                    <div class="type-details">
                        <div class="detail-item">
                            <div class="detail-label">Type Name</div>
                            <div class="detail-value">
                                @(Model.RoomTypes?.Name ?? "N/A")
                            </div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Type ID</div>
                            <div class="detail-value">
                                @Model.RoomTypeId
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <a href="@Url.Action("Edit", "Room", new { id = Model.RoomId })" class="action-btn edit-btn">
                        <i class="fas fa-edit"></i>
                        Edit Room
                    </a>
                    <button class="action-btn delete-btn" onclick="confirmDelete(@Model.RoomId)">
                        <i class="fas fa-trash"></i>
                        Delete Room
                    </button>
                    <a href="@Url.Action("Index2", "Room")" class="action-btn back-btn-main">
                        <i class="fas fa-arrow-left"></i>
                        Back to List
                    </a>
                </div>
            </div>
        </div>

        <!-- Bookings Section -->
        <div class="bookings-section">
            <div class="section-header">
                <h3>Recent Bookings</h3>
                <div class="bookings-count">
                    @(Model.Bookings?.Count ?? 0) Bookings
                </div>
            </div>

            @if (Model.Bookings != null && Model.Bookings.Any())
            {
                <div class="bookings-list">
                    @foreach (var booking in Model.Bookings.Take(5))
                    {
                        <div class="booking-item">
                            <div class="booking-header">
                                <span class="booking-id">Booking #@booking.BookingId</span>
                                <span class="status @booking.Status.ToLower()">@booking.Status</span>
                            </div>
                            <div class="booking-dates">
                                <div class="date-item">
                                    <div class="date-label">Check In</div>
                                    <div class="date-value">@booking.CheckInDate.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div class="date-item">
                                    <div class="date-label">Check Out</div>
                                    <div class="date-value">@booking.CheckOutDate.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-bookings">
                    <i class="fas fa-calendar-times"></i>
                    <h4>No Bookings Yet</h4>
                    <p>This room hasn't been booked yet.</p>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-door-open"></i>
            <h3>Room Not Found</h3>
            <p>The requested room could not be found.</p>
            <a href="@Url.Action("Index2", "Room")" class="action-btn edit-btn" style="margin-top: 20px; display: inline-block;">
                <i class="fas fa-arrow-left"></i>
                Back to Rooms
            </a>
        </div>
    }

    <style>
        /* Back Button */
        .back-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            text-decoration: none;
            width: fit-content;
        }

            .back-btn:hover {
                background: rgba(184, 134, 11, 0.1);
                border-color: var(--secondary);
            }

        /* Room Details Container */
        .details-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        /* Room Image */
        .room-image-section {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .room-main-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 15px;
            border: 2px solid rgba(184, 134, 11, 0.3);
        }

        .image-placeholder {
            width: 100%;
            height: 300px;
            background: linear-gradient(135deg, #2a2a2a, #1a1a1a);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px dashed rgba(184, 134, 11, 0.3);
            margin-bottom: 15px;
        }

            .image-placeholder i {
                font-size: 48px;
                color: var(--secondary);
                opacity: 0.5;
            }

        /* Room Info */
        .room-info-section {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .room-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .room-title h1 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 5px;
            color: white;
        }

        .room-type {
            color: var(--secondary);
            font-size: 18px;
            font-weight: 500;
        }

        .room-status {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }

        .available {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .occupied {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .maintenance {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        /* Room Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .detail-label {
            color: #ccc;
            font-size: 14px;
            font-weight: 500;
        }

        .detail-value {
            color: white;
            font-size: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .detail-value i {
                color: var(--secondary);
                width: 16px;
            }

        /* Room Type Info */
        .room-type-info {
            background: rgba(184, 134, 11, 0.1);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            border: 1px solid rgba(184, 134, 11, 0.2);
        }

            .room-type-info h3 {
                color: var(--secondary);
                margin-bottom: 10px;
                font-size: 18px;
            }

        .type-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 25px;
        }

        .action-btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
        }

        .edit-btn {
            background: linear-gradient(135deg, var(--secondary), var(--accent));
            color: white;
        }

            .edit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(184, 134, 11, 0.4);
            }

        .delete-btn {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

            .delete-btn:hover {
                background: rgba(239, 68, 68, 0.3);
            }

        .back-btn-main {
            background: rgba(255, 255, 255, 0.05);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .back-btn-main:hover {
                background: rgba(255, 255, 255, 0.1);
            }

        /* Bookings Section */
        .bookings-section {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

            .section-header h3 {
                color: white;
                font-weight: 600;
                font-size: 1.5rem;
            }

        .bookings-count {
            background: rgba(184, 134, 11, 0.2);
            color: var(--secondary);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }

        .bookings-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .booking-item {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            padding: 15px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .booking-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .booking-id {
            font-weight: 600;
            color: var(--secondary);
        }

        .booking-dates {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            font-size: 14px;
        }

        .date-item {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .date-label {
            color: #ccc;
            font-size: 12px;
        }

        .date-value {
            color: white;
            font-weight: 500;
        }

        .no-bookings {
            text-align: center;
            padding: 40px 20px;
            color: #ccc;
        }

            .no-bookings i {
                font-size: 48px;
                color: var(--secondary);
                margin-bottom: 15px;
                opacity: 0.5;
            }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #ccc;
        }

            .empty-state i {
                font-size: 64px;
                color: var(--secondary);
                margin-bottom: 20px;
                opacity: 0.5;
            }

            .empty-state h3 {
                font-size: 24px;
                margin-bottom: 10px;
                color: white;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .details-container {
                grid-template-columns: 1fr;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .type-details {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 576px) {
            .room-header {
                flex-direction: column;
                gap: 15px;
            }
        }
    </style>

    <script>
        // Confirm delete function
        function confirmDelete(roomId) {
            if (confirm('Are you sure you want to delete this room? This action cannot be undone.')) {
                submitAdminPost('@Url.Action("Delete", "Room")', { id: roomId });
            }
        }
    </script>
</body>