@model IEnumerable<BookifyHotel.Model.Room>

@{
    ViewData["Title"] = "Our Rooms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    
    .rooms-page {
        background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
        min-height: 100vh;
        padding: 100px 20px 50px;
    }

    .rooms-header {
        text-align: center;
        margin-bottom: 60px;
    }

        .rooms-header h1 {
            font-size: 3.5rem;
            font-weight: 300;
            color: white;
            margin-bottom: 20px;
            background: linear-gradient(45deg, #b8860b, #ffd700);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .rooms-header p {
            font-size: 1.2rem;
            color: #ccc;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.6;
        }

    .rooms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .room-card {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
        position: relative;
    }

        .room-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(184, 134, 11, 0.2);
            border-color: rgba(184, 134, 11, 0.3);
        }

    .room-image {
        width: 100%;
        height: 250px;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: relative;
    }

        .room-image::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.7) 100%);
        }

    .room-status {
        position: absolute;
        top: 20px;
        right: 20px;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .status-available {
        background: linear-gradient(135deg, #10b981, #34d399);
        color: white;
    }

    .status-booked {
        background: linear-gradient(135deg, #ef4444, #f87171);
        color: white;
    }

    .status-maintenance {
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        color: white;
    }

    .room-badge {
        position: absolute;
        top: 20px;
        left: 20px;
        background: rgba(0, 0, 0, 0.7);
        color: #b8860b;
        padding: 6px 12px;
        border-radius: 15px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .room-content {
        padding: 30px;
    }

    .room-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
    }

    .room-title {
        flex: 1;
    }

        .room-title h3 {
            font-size: 1.5rem;
            color: white;
            margin-bottom: 5px;
            font-weight: 500;
        }

    .room-type {
        color: #b8860b;
        font-size: 1rem;
        font-weight: 400;
    }

    .room-floor {
        background: rgba(184, 134, 11, 0.2);
        color: #b8860b;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .room-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin: 20px 0;
    }

    .detail-item {
        display: flex;
        align-items: center;
        color: #ccc;
        font-size: 0.9rem;
    }

        .detail-item i {
            color: #b8860b;
            margin-right: 8px;
            font-size: 1rem;
            width: 20px;
            text-align: center;
        }

    .room-actions {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

    .room-btn {
        flex: 1;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #b8860b, #d4af37);
        color: white;
        box-shadow: 0 5px 15px rgba(184, 134, 11, 0.3);
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(184, 134, 11, 0.4);
        }

    .btn-secondary {
        background: transparent;
        color: #b8860b;
        border: 2px solid #b8860b;
    }

        .btn-secondary:hover {
            background: #b8860b;
            color: white;
            transform: translateY(-2px);
        }

    .btn-disabled {
        background: #6b7280;
        color: #9ca3af;
        cursor: not-allowed;
    }

        .btn-disabled:hover {
            transform: none;
            box-shadow: none;
        }

 
    .filters-section {
        max-width: 1200px;
        margin: 0 auto 50px;
        background: rgba(255, 255, 255, 0.05);
        padding: 30px;
        border-radius: 15px;
        backdrop-filter: blur(10px);
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

        .filter-group label {
            color: #b8860b;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .filter-select {
        padding: 12px 15px;
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .filter-select:focus {
            outline: none;
            border-color: #b8860b;
            box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.1);
        }

        .filter-select option {
            background: #1a1a1a;
            color: white;
        }

  
    .no-rooms {
        text-align: center;
        color: #ccc;
        font-size: 1.2rem;
        padding: 60px 20px;
    }

   
    @@media (max-width: 768px) {
        .rooms-page {
            padding: 80px 20px 30px;
        }

        .rooms-header h1 {
            font-size: 2.5rem;
        }

        .rooms-grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .room-actions {
            flex-direction: column;
        }

        .filters-grid {
            grid-template-columns: 1fr;
        }

        .room-details {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .rooms-header h1 {
            font-size: 2rem;
        }

        .room-content {
            padding: 25px 20px;
        }

        .room-header {
            flex-direction: column;
            gap: 10px;
        }

        .room-floor {
            align-self: flex-start;
        }
    }
</style>

<section class="rooms-page">
    <div class="rooms-header">
        <h1>Our Luxury Rooms</h1>
        <p>Discover our carefully curated selection of rooms and suites, designed to provide the ultimate comfort and luxury experience.</p>
    </div>

    <div class="filters-section">
        <div class="filters-grid">
            <div class="filter-group">
                <label for="roomType">Room Type</label>
                <select id="roomType" class="filter-select">
                    <option value="all">All Types</option>
                    @if (ViewBag.RoomTypes != null)
                    {
                        foreach (var roomType in ViewBag.RoomTypes)
                        {
                            <option value="@roomType.RoomTypeId">@roomType.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="filter-group">
                <label for="floor">Floor</label>
                <select id="floor" class="filter-select">
                    <option value="all">All Floors</option>
                    @for (int i = 1; i <= 10; i++)
                    {
                        <option value="@i">Floor @i</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label for="status">Status</label>
                <select id="status" class="filter-select">
                    <option value="all">All Status</option>
                    <option value="Available">Available</option>
                    <option value="Booked">Booked</option>
                    <option value="Maintenance">Maintenance</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="availability">Availability</label>
                <select id="availability" class="filter-select">
                    <option value="all">All Rooms</option>
                    <option value="available">Available Only</option>
                </select>
            </div>
        </div>
    </div>

    <div class="rooms-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var room in Model)
            {
              
                string roomTypeName = "Unknown";
                decimal pricePerNight = 0;

                if (room.RoomTypes != null)
                {
                    roomTypeName = room.RoomTypes.Name;
                    pricePerNight = room.RoomTypes.PricePerNight;
                }
                else if (ViewBag.RoomTypes != null)
                {
                    // Fallback using ViewBag if Include wasn't used
                    var typesList = (IEnumerable<dynamic>)ViewBag.RoomTypes;
                    var type = typesList.FirstOrDefault(t => t.RoomTypeId == room.RoomTypeId);
                    if (type != null)
                    {
                        roomTypeName = type.Name;
                        pricePerNight = type.PricePerNight;
                    }
                }

                <div class="room-card" data-type="@room.RoomTypeId" data-floor="@room.Floor" data-status="@room.Status" data-available="@room.IsAvailable.ToString().ToLower()">
                    <div class="room-image" style="background-image: url('@(string.IsNullOrEmpty(room.ImageUrl) ? "https://images.unsplash.com/photo-1611892440504-42a792e24d32?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1170&q=80" : room.ImageUrl)')">
                        <div class="room-status @GetStatusClass(room.Status)">
                            @room.Status
                        </div>
                        <div class="room-price" style="position: absolute; bottom: 20px; right: 20px; background: rgba(0,0,0,0.8); padding: 8px 15px; border-radius: 20px; color: #b8860b; font-weight: bold;">
                            $@pricePerNight.ToString("N0") <span style="font-size: 0.8em; color: #fff;">/ night</span>
                        </div>
                        @if (room.IsAvailable)
                        {
                            <div class="room-badge">Available</div>
                        }
                    </div>

                    <div class="room-content">
                        <div class="room-header">
                            <div class="room-title">
                                <h3>Room @room.RoomNumber</h3>
                                <div class="room-type">@roomTypeName</div>
                            </div>
                            <div class="room-floor">
                                Floor @room.Floor
                            </div>
                        </div>

                        <div class="room-details">
                            <div class="detail-item">
                                <i class="fas fa-bed"></i>
                                <span>@GetBedType(roomTypeName)</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-user-friends"></i>
                                <span>@GetCapacity(roomTypeName) Guests</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-ruler-combined"></i>
                                <span>@GetRoomSize(roomTypeName)</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-eye"></i>
                                <span>@GetViewType(roomTypeName)</span>
                            </div>
                        </div>

                        <div class="room-actions">
                            @if (room.IsAvailable && (room.Status == "Available" || string.IsNullOrEmpty(room.Status)))
                            {
                                <a asp-controller="Booking" asp-action="Checkout" asp-route-roomId="@room.RoomId" class="room-btn btn-primary">
                                    <i class="fas fa-calendar-check"></i>
                                    Book Now
                                </a>

                                <a href="@Url.Action("Details", "Room", new { id = room.RoomId })" class="room-btn btn-secondary">
                                    <i class="fas fa-info-circle"></i>
                                    Details
                                </a>
                            }
                            else
                            {
                                <button class="room-btn btn-disabled" disabled>
                                    <i class="fas fa-lock"></i>
                                    Not Available
                                </button>
                                <a href="@Url.Action("Details", "Room", new { id = room.RoomId })" class="room-btn btn-secondary">
                                    <i class="fas fa-info-circle"></i>
                                    View Details
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-rooms">
                <i class="fas fa-door-closed" style="font-size: 3rem; margin-bottom: 20px; color: #b8860b;"></i>
                <h3>No Rooms Available</h3>
                <p>Please check back later or contact us for more information.</p>
            </div>
        }
    </div>
</section>

<script>
    // فلترة الغرف
    document.addEventListener('DOMContentLoaded', function() {
        const filters = {
            roomType: document.getElementById('roomType'),
            floor: document.getElementById('floor'),
            status: document.getElementById('status'),
            availability: document.getElementById('availability')
        };

        function filterRooms() {
            const roomTypeValue = filters.roomType.value;
            const floorValue = filters.floor.value;
            const statusValue = filters.status.value;
            const availabilityValue = filters.availability.value;

            document.querySelectorAll('.room-card').forEach(card => {
                const roomType = card.getAttribute('data-type');
                const floor = card.getAttribute('data-floor');
                const status = card.getAttribute('data-status');
                const available = card.getAttribute('data-available');

                let show = true;

                if (roomTypeValue !== 'all' && roomType !== roomTypeValue) show = false;
                if (floorValue !== 'all' && floor !== floorValue) show = false;
                if (statusValue !== 'all' && status !== statusValue) show = false;
                if (availabilityValue === 'available' && available !== 'true') show = false;

                card.style.display = show ? 'block' : 'none';
            });
        }

       
        Object.values(filters).forEach(filter => {
            if(filter) filter.addEventListener('change', filterRooms);
        });

        
        document.querySelectorAll('.room-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-10px)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });
    });
</script>

@functions {
    public string GetStatusClass(string status)
    {
        return status?.ToLower() switch
        {
            "available" => "status-available",
            "booked" => "status-booked",
            "maintenance" => "status-maintenance",
            _ => "status-available"
        };
    }

    public string GetBedType(string roomTypeName)
    {
        return (roomTypeName?.ToLower() ?? "") switch
        {
            var n when n.Contains("single") => "Single Bed",
            var n when n.Contains("double") => "Double Bed",
            var n when n.Contains("suite") => "King Bed",
            var n when n.Contains("royal") => "King Bed + Sofa",
            var n when n.Contains("family") => "Two Double Beds",
            _ => "Double Bed"
        };
    }

    public string GetCapacity(string roomTypeName)
    {
        return (roomTypeName?.ToLower() ?? "") switch
        {
            var n when n.Contains("single") => "1",
            var n when n.Contains("double") => "2",
            var n when n.Contains("royal") => "3",
            var n when n.Contains("family") => "4",
            _ => "2"
        };
    }

    public string GetRoomSize(string roomTypeName)
    {
        return (roomTypeName?.ToLower() ?? "") switch
        {
            var n when n.Contains("single") => "25 m²",
            var n when n.Contains("double") => "35 m²",
            var n when n.Contains("suite") => "50 m²",
            var n when n.Contains("royal") => "75 m²",
            var n when n.Contains("family") => "45 m²",
            _ => "35 m²"
        };
    }

    public string GetViewType(string roomTypeName)
    {
        return (roomTypeName?.ToLower() ?? "") switch
        {
            var n when n.Contains("garden") => "Garden View",
            var n when n.Contains("sea") || n.Contains("ocean") => "Ocean View",
            _ => "City View"
        };
    }
}