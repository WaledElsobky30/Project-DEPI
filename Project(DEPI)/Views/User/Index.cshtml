@model IEnumerable<DAL.ViewModel.UserViewModel>

@{
    ViewData["Title"] = "Users Management";
    Layout = "~/Views/Shared/_SideBarLayout.cshtml";
}

<body data-active-page="users">
    <div class="header">
        <h2>Users Management</h2>
        <div class="user-info">
            <div>
                <h4>System Administrator</h4>
                <p style="color: #b8860b;">Admin Panel</p>
            </div>
            <img src="https://ui-avatars.com/api/?name=Admin&background=b8860b&color=fff" alt="User">
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #d1fae5; padding: 15px; border-radius: 10px; margin-bottom: 20px;">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #fee2e2; padding: 15px; border-radius: 10px; margin-bottom: 20px;">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <div class="page-actions">
        <div class="filters-section">
            <div class="search-box">
                <input type="text" placeholder="Search users...">
                <i class="fas fa-search"></i>
            </div>
            <select class="filter-select" id="roleFilter">
                <option value="">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="User">User</option>
            </select>
        </div>
        <button class="add-btn" onclick="location.href='@Url.Action("Create", "User")'">
            <i class="fas fa-plus"></i> New User
        </button>
    </div>

    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-icon total-users">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count()</h3>
                <p>Total Users</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon admins">
                <i class="fas fa-crown"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(u => u.Roles.Contains("Admin"))</h3>
                <p>Admins</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon regular-users">
                <i class="fas fa-user"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(u => u.Roles.Contains("User"))</h3>
                <p>Regular Users</p>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header">
            <h3>All Users List</h3>
            <span class="total-items">Showing @Model.Count() users</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>USER ID</th>
                        <th>USER INFO</th>
                        <th>CONTACT</th>
                        <th>ROLES</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>USR-@item.UserId</strong>
                            </td>
                            <td>
                                <div class="user-info">
                                    <img src="https://ui-avatars.com/api/?name=@item.FullName&background=b8860b&color=fff&size=40" alt="@item.FullName" class="user-avatar">
                                    <div class="user-details">
                                        <strong>@item.FullName</strong>
                                        <div class="user-email">@item.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="contact-info">
                                    <div class="contact-item">
                                        <i class="fas fa-envelope"></i>
                                        <span>@item.Email</span>
                                    </div>
                                    <div class="contact-item">
                                        <i class="fas fa-phone"></i>
                                        <span>@(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="roles-container">
                                    @if (item.Roles != null && item.Roles.Any())
                                    {
                                        @foreach (var role in item.Roles)
                                        {
                                            <span class="role-badge @(role.ToLower())">
                                                <i class="fas @GetRoleIcon(role)"></i> @role
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="role-badge user"><i class="fas fa-user"></i> User</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@Url.Action("Details", "User", new { id = item.UserId })" class="action-btn view-btn">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="@Url.Action("Edit", "User", new { id = item.UserId })" class="action-btn edit-btn">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="javascript:void(0);" onclick="confirmDelete('@item.UserId', '@item.FullName')" class="action-btn delete-btn">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-users-slash empty-icon"></i>
                <h3>No Users Found</h3>
                <p>No users have been registered yet. Start by creating a new user.</p>
                <button class="add-btn" onclick="location.href='@Url.Action("Create", "User")'" style="margin-top: 20px;">
                    <i class="fas fa-plus"></i> Create First User
                </button>
            </div>
        }
    </div>

    <style>

        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            gap: 20px;
        }

        .filters-section {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            width: 250px;
        }

            .search-box input {
                width: 100%;
                padding: 12px 20px 12px 45px;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                color: white;
                backdrop-filter: blur(10px);
            }

                .search-box input:focus {
                    outline: none;
                    border-color: #b8860b;
                }

            .search-box i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #b8860b;
            }

        .filter-select {
            padding: 12px 15px;
            background: black;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: white;
            backdrop-filter: blur(10px);
            cursor: pointer;
        }

        .add-btn {
            background: linear-gradient(135deg, #b8860b, #d4af37);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
        }

            .add-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(184, 134, 11, 0.4);
            }

        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .total-users {
            background: linear-gradient(135deg, #3b82f6, #60a5fa);
        }

        .admins {
            background: linear-gradient(135deg, #ef4444, #f87171);
        }

        .regular-users {
            background: linear-gradient(135deg, #10b981, #34d399);
        }

        .stat-info h3 {
            font-size: 24px;
            font-weight: 700;
            color: white;
            margin: 0;
        }

        .stat-info p {
            color: #ccc;
            font-size: 14px;
            margin: 0;
        }

        .table-container {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

            .table-header h3 {
                color: white;
                font-weight: 600;
                font-size: 1.5rem;
                margin: 0;
            }

        .total-items {
            color: #b8860b;
            font-weight: 600;
            background: rgba(184, 134, 11, 0.1);
            padding: 8px 15px;
            border-radius: 10px;
            border: 1px solid rgba(184, 134, 11, 0.2);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 15px 12px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            color: #ddd;
        }

        th {
            background-color: rgba(0, 0, 0, 0.3);
            color: #b8860b;
            font-weight: 600;
        }

        tr:hover {
            background-color: rgba(184, 134, 11, 0.05);
        }

        .role-badge {
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

            .role-badge.admin {
                background: rgba(239, 68, 68, 0.2);
                color: #ef4444;
                border: 1px solid rgba(239, 68, 68, 0.3);
            }

            .role-badge.user {
                background: rgba(59, 130, 246, 0.2);
                color: #3b82f6;
                border: 1px solid rgba(59, 130, 246, 0.3);
            }

        .action-buttons {
            display: flex;
            gap: 6px;
        }

        .action-btn {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: 0.3s;
        }

        .view-btn {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

            .view-btn:hover {
                background: rgba(16, 185, 129, 0.3);
                color: #10b981;
            }

        .edit-btn {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

            .edit-btn:hover {
                background: rgba(59, 130, 246, 0.3);
                color: #3b82f6;
            }

        .delete-btn {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

            .delete-btn:hover {
                background: rgba(239, 68, 68, 0.3);
                color: #ef4444;
            }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #b8860b;
            margin-right: 10px;
        }

        .user-info {
            display: flex;
            align-items: center;
        }

        .empty-state {
            text-align: center;
            padding: 60px 0;
            color: #ccc;
        }

        .empty-icon {
            font-size: 4rem;
            color: #b8860b;
            margin-bottom: 20px;
            opacity: 0.5;
        }
    </style>

    <script>
        function confirmDelete(userId, userName) {
            if (confirm(`Are you sure you want to delete user "${userName}"? This action cannot be undone.`)) {
                window.location.href = '@Url.Action("Delete", "User")' + '?id=' + userId;
            }
        }

        document.querySelector('.search-box input').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const tableRows = document.querySelectorAll('tbody tr');
            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });

        document.getElementById('roleFilter').addEventListener('change', function() {
            const role = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('tbody tr');
            tableRows.forEach(row => {
                const badges = row.querySelectorAll('.role-badge');
                let hasRole = false;
                badges.forEach(b => { if(b.textContent.toLowerCase().includes(role)) hasRole = true; });
                row.style.display = (role === '' || hasRole) ? '' : 'none';
            });
        });
    </script>
</body>

@functions {
    public string GetRoleIcon(string role)
    {
        if (string.IsNullOrEmpty(role)) return "fa-question";
        return role.ToLower() switch
        {
            "admin" => "fa-crown",
            "user" => "fa-user",
            _ => "fa-question"
        };
    }
}