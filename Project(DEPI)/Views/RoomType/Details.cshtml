@model BookifyHotel.Model.RoomType
@{
    ViewData["Title"] = "Room Type Details";
    Layout = "~/Views/Shared/_SideBarLayout.cshtml";
}

<body data-active-page="roomtypes">
    <div class="header">
        <h2>Room Type Details</h2>
        <div class="user-info">
            <div>
                <h4>System Administrator</h4>
                <p style="color: #b8860b;">Admin</p>
            </div>
            <img src="https://ui-avatars.com/api/?name=Admin&background=b8860b&color=fff" alt="User">
        </div>
    </div>

    <!-- Back Button -->
    <a href="@Url.Action("Index", "RoomType")" class="back-btn">
        <i class="fas fa-arrow-left"></i>
        Back to Room Types
    </a>

    @if (Model != null)
    {
        <div class="details-container">
            <!-- Room Type Info Section -->
            <div class="info-section">
                <div class="info-header">
                    <div class="type-title">
                        <h1>@Model.Name</h1>
                        <div class="type-id">Type ID: @Model.RoomTypeId</div>
                    </div>
                    <div class="price-tag">
                        <div class="price">$@Model.PricePerNight.ToString("N2")</div>
                        <div class="price-label">per night</div>
                    </div>
                </div>

                @* <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Description</div>
                        <div class="detail-value">
                            <i class="fas fa-file-alt"></i>
                            @(string.IsNullOrEmpty(Model.Description) ? "No description available" : Model.Description)
                        </div>
                    </div> *@
                    @* <div class="detail-item">
                        <div class="detail-label">Capacity</div>
                        <div class="detail-value">
                            <i class="fas fa-users"></i>
                            @Model.Capacity persons
                        </div>
                    </div> *@
                    <div class="detail-item">
                        <div class="detail-label">Total Rooms</div>
                        <div class="detail-value">
                            <i class="fas fa-door-open"></i>
                            @(Model.Rooms?.Count ?? 0) rooms
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Available Rooms</div>
                        <div class="detail-value">
                            <i class="fas fa-check-circle"></i>
                            @(Model.Rooms?.Count(r => r.IsAvailable) ?? 0) available
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <a href="@Url.Action("Edit", "RoomType", new { id = Model.RoomTypeId })" class="action-btn edit-btn">
                        <i class="fas fa-edit"></i>
                        Edit Room Type
                    </a>
                    <button class="action-btn delete-btn" onclick="confirmDelete(@Model.RoomTypeId, '@Model.Name')">
                        <i class="fas fa-trash"></i>
                        Delete Room Type
                    </button>
                    <a href="@Url.Action("Index", "RoomType")" class="action-btn back-btn-main">
                        <i class="fas fa-arrow-left"></i>
                        Back to List
                    </a>
                </div>
            </div>

            <!-- Rooms Section -->
            <div class="rooms-section">
                <div class="section-header">
                    <h3>Rooms of This Type</h3>
                    <div class="rooms-count">
                        @(Model.Rooms?.Count ?? 0) Rooms
                    </div>
                </div>

                @if (Model.Rooms != null && Model.Rooms.Any())
                {
                    <div class="rooms-grid">
                        @foreach (var room in Model.Rooms.Take(6))
                        {
                            <div class="room-card">
                                <div class="room-header">
                                    <div class="room-number">Room @room.RoomNumber</div>
                                    <div class="room-status @(room.IsAvailable ? "available" : "occupied")">
                                        @(room.IsAvailable ? "Available" : "Occupied")
                                    </div>
                                </div>
                                <div class="room-details">
                                    <div class="room-floor">
                                        <i class="fas fa-building"></i>
                                        Floor @room.Floor
                                    </div>
                                    <div class="room-main-status">
                                        <i class="fas fa-info-circle"></i>
                                        @room.Status
                                    </div>
                                </div>
                                <div class="room-actions">
                                    <button class="small-btn view-btn" onclick="location.href='@Url.Action("DetailsToAdmin", "Room", new { id = room.RoomId })'">
                                        <i class="fas fa-eye"></i>
                                        View
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.Rooms.Count > 6)
                    {
                        <div class="view-more">
                            <a href="@Url.Action("Index2", "Room")" class="view-all-btn">
                                View All @Model.Rooms.Count Rooms
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="no-rooms">
                        <i class="fas fa-door-closed"></i>
                        <h4>No Rooms Yet</h4>
                        <p>There are no rooms of this type yet.</p>
                        <a href="@Url.Action("Add", "Room")" class="action-btn edit-btn" style="margin-top: 15px;">
                            <i class="fas fa-plus"></i>
                            Add New Room
                        </a>
                    </div>
                }
            </div>
        
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-bed"></i>
            <h3>Room Type Not Found</h3>
            <p>The requested room type could not be found.</p>
            <a href="@Url.Action("Index", "RoomType")" class="action-btn edit-btn" style="margin-top: 20px; display: inline-block;">
                <i class="fas fa-arrow-left"></i>
                Back to Room Types
            </a>
        </div>
    }

    <style>
        /* Back Button */
        .back-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            text-decoration: none;
            width: fit-content;
        }

            .back-btn:hover {
                background: rgba(184, 134, 11, 0.1);
                border-color: var(--secondary);
            }

        /* Details Container */
        .details-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        /* Info Section */
        .info-section {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .info-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .type-title h1 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 5px;
            color: white;
        }

        .type-id {
            color: var(--secondary);
            font-size: 14px;
            font-weight: 500;
        }

        .price-tag {
            text-align: center;
            background: rgba(184, 134, 11, 0.1);
            padding: 15px;
            border-radius: 10px;
            border: 1px solid rgba(184, 134, 11, 0.2);
        }

        .price {
            font-size: 24px;
            font-weight: 700;
            color: var(--secondary);
        }

        .price-label {
            font-size: 12px;
            color: #ccc;
            margin-top: 5px;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .detail-label {
            color: #ccc;
            font-size: 14px;
            font-weight: 500;
        }

        .detail-value {
            color: white;
            font-size: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .detail-value i {
                color: var(--secondary);
                width: 16px;
            }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 25px;
        }

        .action-btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
        }

        .edit-btn {
            background: linear-gradient(135deg, var(--secondary), var(--accent));
            color: white;
        }

            .edit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(184, 134, 11, 0.4);
            }

        .delete-btn {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

            .delete-btn:hover {
                background: rgba(239, 68, 68, 0.3);
            }

        .back-btn-main {
            background: rgba(255, 255, 255, 0.05);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .back-btn-main:hover {
                background: rgba(255, 255, 255, 0.1);
            }

        /* Rooms Section */
        .rooms-section {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

            .section-header h3 {
                color: white;
                font-weight: 600;
                font-size: 1.5rem;
            }

        .rooms-count {
            background: rgba(184, 134, 11, 0.2);
            color: var(--secondary);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }

        /* Rooms Grid */
        .rooms-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .room-card {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            padding: 15px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

            .room-card:hover {
                background: rgba(255, 255, 255, 0.05);
                border-color: rgba(184, 134, 11, 0.2);
            }

        .room-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .room-number {
            font-weight: 600;
            color: white;
        }

        .room-status {
            padding: 4px 8px;
            border-radius: 15px;
            font-size: 10px;
            font-weight: 600;
        }

        .available {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .occupied {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .room-details {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 10px;
            font-size: 12px;
            color: #ccc;
        }

            .room-details i {
                color: var(--secondary);
                margin-right: 5px;
            }

        .room-actions {
            display: flex;
            justify-content: flex-end;
        }

        .small-btn {
            padding: 4px 8px;
            border: none;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .view-btn {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

            .view-btn:hover {
                background: rgba(16, 185, 129, 0.3);
            }

        /* View More */
        .view-more {
            text-align: center;
            margin-top: 15px;
        }

        .view-all-btn {
            color: var(--secondary);
            text-decoration: none;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
            transition: all 0.3s;
        }

            .view-all-btn:hover {
                color: var(--accent);
            }

        /* No Rooms */
        .no-rooms {
            text-align: center;
            padding: 40px 20px;
            color: #ccc;
        }

            .no-rooms i {
                font-size: 48px;
                color: var(--secondary);
                margin-bottom: 15px;
                opacity: 0.5;
            }

            .no-rooms h4 {
                font-size: 18px;
                margin-bottom: 10px;
                color: white;
            }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #ccc;
        }

            .empty-state i {
                font-size: 64px;
                color: var(--secondary);
                margin-bottom: 20px;
                opacity: 0.5;
            }

            .empty-state h3 {
                font-size: 24px;
                margin-bottom: 10px;
                color: white;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .details-container {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .rooms-grid {
                grid-template-columns: 1fr;
            }

            .info-header {
                flex-direction: column;
                gap: 15px;
            }
        }

        @@media (max-width: 576px) {
            .price-tag {
                width: 100%;
            }
        }
    </style>

    <script>
        // Confirm delete function
        function confirmDelete(roomTypeId, roomTypeName) {
            if (confirm(`Are you sure you want to delete the room type "${roomTypeName}"? This action cannot be undone and will affect all rooms of this type.`)) {
                window.location.href = '@Url.Action("Delete", "RoomType")' + '?id=' + roomTypeId;
            }
        }
    </script>
</body>