@model IEnumerable<BookifyHotel.Model.Payment>
@{
    ViewData["Title"] = "Payments Management";
    Layout = "~/Views/Shared/_SideBarLayout.cshtml";
}

<body data-active-page="payments">
    <div class="header">
        <h2>Payments Management</h2>
        <div class="user-info">
            <div>
                <h4>System Administrator</h4>
                <p style="color: #b8860b;">Admin</p>
            </div>
            <img src="https://ui-avatars.com/api/?name=Admin&background=b8860b&color=fff" alt="User">
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    <!-- Page Actions -->
    <div class="page-actions">
        <div class="filters-section">
            <div class="search-box">
                <input type="text" placeholder="Search payments...">
                <i class="fas fa-search"></i>
            </div>
            <select class="filter-select" id="statusFilter">
                <option value="">All Status</option>
                <option value="Paid">Paid</option>
                <option value="Pending">Pending</option>
                <option value="Failed">Failed</option>
            </select>
            <select class="filter-select" id="methodFilter">
                <option value="">All Methods</option>
                <option value="Credit Card">Credit Card</option>
                <option value="Debit Card">Debit Card</option>
                <option value="PayPal">PayPal</option>
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="Cash">Cash</option>
            </select>
        </div>
        <!-- No Add Button - Payments are created automatically with bookings -->
    </div>

    <!-- Stats Cards -->
    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-icon total-payments">
                <i class="fas fa-credit-card"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count()</h3>
                <p>Total Payments</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon paid">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(p => p.PaymentStatus == "Paid")</h3>
                <p>Paid</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon pending">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(p => p.PaymentStatus == "Pending")</h3>
                <p>Pending</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon revenue">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="stat-info">
                @{
                    var totalRevenue = Model.Where(p => p.PaymentStatus == "Paid").Sum(p => p.Amount);
                }
                <h3>$@totalRevenue.ToString("N0")</h3>
                <p>Total Revenue</p>
            </div>
        </div>
    </div>

    <!-- Payments Table -->
    <div class="table-container">
        <div class="table-header">
            <h3>All Payments</h3>
            <span class="total-items">Showing @Model.Count() payments</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>PAYMENT ID</th>
                        <th>BOOKING INFO</th>
                        <th>AMOUNT</th>
                        <th>PAYMENT METHOD</th>
                        <th>DATE</th>
                        <th>TRANSACTION REF</th>
                        <th>STATUS</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>
                                <strong>PMT@(payment.PaymentId.ToString("D4"))</strong>
                            </td>
                            <td>
                                <div class="booking-info">
                                    <strong>Booking #@payment.BookingId</strong>
                                    @if (payment.Booking != null)
                                    {
                                        <div style="font-size: 12px; color: #ccc;">
                                            @payment.Booking.UserProfile?.FullName
                                        </div>
                                        <div style="font-size: 11px; color: #999;">
                                            Room @payment.Booking.Room?.RoomNumber
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="amount-info">
                                    <strong>$@payment.Amount.ToString("N2")</strong>
                                </div>
                            </td>
                            <td>
                                <div class="method-info">
                                    <span class="payment-method @payment.PaymentMethod?.ToLower()?.Replace(" ", "-")">
                                        <i class="fas @GetPaymentMethodIcon(payment.PaymentMethod)"></i>
                                        @payment.PaymentMethod
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="date-info">
                                    <div class="date-value">@payment.PaymentDate.ToString("MMM dd, yyyy")</div>
                                    <div style="font-size: 11px; color: #ccc;">@payment.PaymentDate.ToString("hh:mm tt")</div>
                                </div>
                            </td>
                            <td>
                                <div class="transaction-info">
                                    <code style="font-size: 11px; color: #ccc;">@payment.TransactionRefrence</code>
                                </div>
                            </td>
                            <td>
                                <span class="status @payment.PaymentStatus?.ToLower()">@payment.PaymentStatus</span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <!-- View Only - No Edit/Delete -->
                                    <button class="action-btn view-btn" onclick="location.href='@Url.Action("Details", "Payment", new { id = payment.PaymentId })'">
                                        <i class="fas fa-eye"></i>
                                        View Details
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-credit-card"></i>
                <h3>No Payments Found</h3>
                <p>No payments have been recorded yet. Payments are created automatically when users make bookings.</p>
            </div>
        }
    </div>

    <style>
        /* Page Actions */
        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            gap: 20px;
        }

        .filters-section {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            width: 250px;
        }

            .search-box input {
                width: 100%;
                padding: 12px 20px 12px 45px;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                color: white;
                font-size: 14px;
                backdrop-filter: blur(10px);
            }

                .search-box input:focus {
                    outline: none;
                    border-color: var(--secondary);
                }

            .search-box i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--secondary);
            }

        .filter-select {
            padding: 12px 15px;
            background: black;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: white;
            font-size: 14px;
            backdrop-filter: blur(10px);
            cursor: pointer;
        }

            .filter-select:focus {
                outline: none;
                border-color: var(--secondary);
            }

        /* Stats Cards */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: all 0.3s;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .stat-card:hover {
                transform: translateY(-5px);
                border-color: rgba(184, 134, 11, 0.3);
            }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .total-payments {
            background: linear-gradient(135deg, #3b82f6, #60a5fa);
        }

        .paid {
            background: linear-gradient(135deg, #10b981, #34d399);
        }

        .pending {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
        }

        .revenue {
            background: linear-gradient(135deg, #8b5cf6, #a78bfa);
        }

        .stat-info h3 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 5px;
            color: white;
        }

        .stat-info p {
            color: #ccc;
            font-size: 14px;
        }

        /* Table Container */
        .table-container {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

            .table-header h3 {
                color: white;
                font-weight: 600;
                font-size: 1.5rem;
            }

        .total-items {
            color: var(--secondary);
            font-weight: 600;
            background: rgba(184, 134, 11, 0.1);
            padding: 8px 15px;
            border-radius: 10px;
            border: 1px solid rgba(184, 134, 11, 0.2);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 15px 12px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        th {
            background-color: rgba(0, 0, 0, 0.3);
            color: var(--secondary);
            font-weight: 600;
            font-size: 13px;
        }

        tr:hover {
            background-color: rgba(184, 134, 11, 0.05);
        }

        /* Booking Info */
        .booking-info strong {
            color: white;
            font-size: 14px;
            display: block;
        }

        /* Amount Info */
        .amount-info strong {
            color: white;
            font-size: 14px;
            font-weight: 600;
        }

        /* Payment Method */
        .payment-method {
            padding: 6px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

            .payment-method.credit-card {
                background: rgba(59, 130, 246, 0.2);
                color: #3b82f6;
                border: 1px solid rgba(59, 130, 246, 0.3);
            }

            .payment-method.debit-card {
                background: rgba(139, 92, 246, 0.2);
                color: #8b5cf6;
                border: 1px solid rgba(139, 92, 246, 0.3);
            }

            .payment-method.paypal {
                background: rgba(59, 130, 246, 0.2);
                color: #3b82f6;
                border: 1px solid rgba(59, 130, 246, 0.3);
            }

            .payment-method.bank-transfer {
                background: rgba(16, 185, 129, 0.2);
                color: #10b981;
                border: 1px solid rgba(16, 185, 129, 0.3);
            }

            .payment-method.cash {
                background: rgba(107, 114, 128, 0.2);
                color: #6b7280;
                border: 1px solid rgba(107, 114, 128, 0.3);
            }

        /* Date Info */
        .date-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .date-value {
            color: white;
            font-size: 12px;
            font-weight: 500;
        }

        /* Transaction Info */
        .transaction-info code {
            background: rgba(255, 255, 255, 0.05);
            padding: 4px 8px;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
        }

        /* Status Styles */
        .status {
            padding: 6px 10px;
            border-radius: 15px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            .status.paid {
                background: rgba(16, 185, 129, 0.2);
                color: #10b981;
                border: 1px solid rgba(16, 185, 129, 0.3);
            }

            .status.pending {
                background: rgba(245, 158, 11, 0.2);
                color: #f59e0b;
                border: 1px solid rgba(245, 158, 11, 0.3);
            }

            .status.failed {
                background: rgba(239, 68, 68, 0.2);
                color: #ef4444;
                border: 1px solid rgba(239, 68, 68, 0.3);
            }

        /* Action Buttons - View Only */
        .action-buttons {
            display: flex;
            gap: 6px;
        }

        .action-btn {
            padding: 6px 10px;
            border: none;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }

        .view-btn {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

            .view-btn:hover {
                background: rgba(16, 185, 129, 0.3);
            }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #ccc;
        }

            .empty-state i {
                font-size: 64px;
                color: var(--secondary);
                margin-bottom: 20px;
                opacity: 0.5;
            }

            .empty-state h3 {
                font-size: 24px;
                margin-bottom: 10px;
                color: white;
            }

            .empty-state p {
                margin-bottom: 20px;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .page-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .filters-section {
                justify-content: center;
            }

            .search-box {
                width: 100%;
            }

            .table-container {
                overflow-x: auto;
            }

            table {
                min-width: 1200px;
            }

            .stats-container {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 576px) {
            .stats-container {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .filters-section {
                flex-direction: column;
            }

            .filter-select {
                width: 100%;
            }
        }
    </style>

    <script>
        // Search functionality
        document.querySelector('.search-box input').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const tableRows = document.querySelectorAll('tbody tr');

            tableRows.forEach(row => {
                const paymentId = row.querySelector('td:first-child strong').textContent.toLowerCase();
                const transactionRef = row.querySelector('.transaction-info code').textContent.toLowerCase();
                const bookingId = row.querySelector('.booking-info strong').textContent.toLowerCase();

                if (paymentId.includes(searchTerm) || transactionRef.includes(searchTerm) || bookingId.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Status filter
        document.getElementById('statusFilter').addEventListener('change', function() {
            const status = this.value;
            const tableRows = document.querySelectorAll('tbody tr');

            tableRows.forEach(row => {
                const rowStatus = row.querySelector('.status').textContent;
                if (status === '' || rowStatus === status) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Payment method filter
        document.getElementById('methodFilter').addEventListener('change', function() {
            const method = this.value;
            const tableRows = document.querySelectorAll('tbody tr');

            tableRows.forEach(row => {
                const rowMethod = row.querySelector('.payment-method').textContent;
                if (method === '' || rowMethod === method) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Add hover effect to table rows
        document.querySelectorAll('tbody tr').forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.backgroundColor = 'rgba(184, 134, 11, 0.05)';
            });

            row.addEventListener('mouseleave', function() {
                this.style.backgroundColor = '';
            });
        });
    </script>
</body>

@functions {
    public string GetPaymentMethodIcon(string method)
    {
        if (string.IsNullOrEmpty(method))
            return "fa-credit-card";

        return method.ToLower() switch
        {
            "credit card" => "fa-credit-card",
            "debit card" => "fa-credit-card",
            "paypal" => "fa-paypal",
            "bank transfer" => "fa-university",
            "cash" => "fa-money-bill",
            _ => "fa-credit-card"
        };
    }
}