@using BookifyHotel.Controllers
@using Project_DEPI_.Controllers
@using DAL.ViewModel
@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "~/Views/Shared/_SideBarLayout.cshtml";

    // ✅ Casting لـ RecentBookings
    var recentBookings = ViewBag.RecentBookings as List<BookingViewModel>;
}

<body data-active-page="dashboard">
    <div class="header">
        <h2>Dashboard Overview</h2>
        <div class="user-info">
            <div>
                <h4>System Administrator</h4>
                <p style="color: #b8860b;">Admin</p>
            </div>
            <img src="https://ui-avatars.com/api/?name=Admin&background=b8860b&color=fff" alt="User">
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-icon rooms-icon">
                <i class="fas fa-door-open"></i>
            </div>
            <div class="stat-info">
                <h3>@(ViewBag.TotalRooms ?? 0)</h3>
                <p>Total Rooms</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bookings-icon">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-info">
                <h3>@(ViewBag.TodaysBookings ?? 0)</h3>
                <p>Today's Bookings</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon users-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-info">
                <h3>@(ViewBag.TotalUsers ?? 0)</h3>
                <p>Registered Users</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon revenue-icon">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="stat-info">
                <h3>$@((ViewBag.MonthlyRevenue ?? 0).ToString("N0"))</h3>
                <p>Monthly Revenue</p>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <div class="action-card" onclick="location.href='@Url.Action("Index2", "Room")'">
            <div class="action-icon add-room">
                <i class="fas fa-plus"></i>
            </div>
            <p>Manage Rooms</p>
        </div>
        <div class="action-card" onclick="location.href='@Url.Action("Create", "Booking")'">
            <div class="action-icon add-booking">
                <i class="fas fa-calendar-plus"></i>
            </div>
            <p>Create Booking</p>
        </div>
        <div class="action-card" onclick="location.href='@Url.Action("Create", "User")'">
            <!-- ✅ صححت من UserProfile إلى User -->
            <div class="action-icon add-user">
                <i class="fas fa-user-plus"></i>
            </div>
            <p>Add New User</p>
        </div>
        <div class="action-card" onclick="location.href='@Url.Action("Index", "Booking")'">
            <!-- ✅ غيرت من Report إلى Booking -->
            <div class="action-icon reports">
                <i class="fas fa-chart-pie"></i>
            </div>
            <p>View Bookings</p>
        </div>
    </div>

    <!-- Recent Bookings -->
    <div class="recent-bookings">
        <div class="section-header">
            <h3>Recent Bookings</h3>
            <a href="@Url.Action("Index", "Booking")" class="view-all">View All Bookings</a>
        </div>

        @if (recentBookings != null && recentBookings.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>BOOKING ID</th>
                        <th>GUEST NAME</th>
                        <th>ROOM</th>
                        <th>TYPE</th>
                        <th>CHECK IN</th>
                        <th>CHECK OUT</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in recentBookings)
                    {
                        <tr>
                            <td>BK@(booking.BookingId.ToString("D3"))</td>
                            <td>@booking.FullName</td> <!-- ✅ من FullName -->
                            <td>@booking.RoomNumber</td>
                            <td>@booking.RoomType</td>
                            <td>@booking.CheckInDate.ToString("yyyy-MM-dd")</td>
                            <td>@booking.CheckOutDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="status @(booking.Status.ToLower())">
                                    @booking.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="no-data">
                <i class="fas fa-calendar-times"></i>
                <p>No recent bookings found</p>
            </div>
        }
    </div>

    <style>
        /* Stats Cards */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 20px;
            transition: all 0.3s;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .stat-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 35px rgba(184, 134, 11, 0.2);
                border-color: rgba(184, 134, 11, 0.3);
            }

        .stat-icon {
            width: 70px;
            height: 70px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
        }

        .rooms-icon {
            background: linear-gradient(135deg, #b8860b, #d4af37);
        }

        .bookings-icon {
            background: linear-gradient(135deg, #10b981, #34d399);
        }

        .users-icon {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
        }

        .revenue-icon {
            background: linear-gradient(135deg, #ef4444, #f87171);
        }

        .stat-info h3 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 8px;
            color: white;
        }

        .stat-info p {
            color: #ccc;
            font-size: 15px;
        }

        /* Quick Actions */
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .action-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 15px;
            cursor: pointer;
            transition: all 0.3s;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .action-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 35px rgba(184, 134, 11, 0.2);
                border-color: rgba(184, 134, 11, 0.3);
            }

        .action-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .add-room {
            background: linear-gradient(135deg, #b8860b, #d4af37);
        }

        .add-booking {
            background: linear-gradient(135deg, #10b981, #34d399);
        }

        .add-user {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
        }

        .reports {
            background: linear-gradient(135deg, #ef4444, #f87171);
        }

        .action-card p {
            font-weight: 600;
            color: white;
            font-size: 16px;
        }

        /* Recent Bookings */
        .recent-bookings {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

            .section-header h3 {
                color: white;
                font-weight: 600;
                font-size: 1.5rem;
            }

        .view-all {
            color: var(--secondary);
            text-decoration: none;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 8px;
            background: rgba(184, 134, 11, 0.1);
            transition: all 0.3s;
        }

            .view-all:hover {
                background: rgba(184, 134, 11, 0.2);
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        th {
            background-color: rgba(0, 0, 0, 0.3);
            color: var(--secondary);
            font-weight: 600;
            font-size: 14px;
        }

        tr:hover {
            background-color: rgba(184, 134, 11, 0.05);
        }

        .status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .confirmed {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .pending {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .cancelled {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        /* No Data */
        .no-data {
            text-align: center;
            padding: 40px 20px;
            color: #9ca3af;
        }

            .no-data i {
                font-size: 48px;
                margin-bottom: 15px;
                color: #6b7280;
            }

            .no-data p {
                font-size: 16px;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .stats-container, .quick-actions {
                grid-template-columns: 1fr 1fr;
            }

            table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
        }

        @@media (max-width: 576px) {
            .stats-container, .quick-actions {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <script>
        // Add hover effect to action cards
        document.querySelectorAll('.action-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-8px)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // Add click effect to action cards
        document.querySelectorAll('.action-card').forEach(card => {
            card.addEventListener('click', function() {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 150);
            });
        });

        // Add hover effect to stat cards
        document.querySelectorAll('.stat-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-8px)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // Auto-refresh dashboard every 60 seconds
        setTimeout(() => {
            window.location.reload();
        }, 60000);
    </script>
</body>