@{
    ViewData["Title"] = "BookifyHotel - 5-Star Luxury Stays & Hospitality";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #070a10;
            --gold: #d4af37;
            --gold-dark: #b8860b;
            --gold-soft: rgba(212, 175, 55, 0.16);
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --surface: rgba(15, 23, 42, 0.65);
            --border: rgba(255, 255, 255, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        .hero-backdrop {
            position: relative;
            min-height: 100vh;
            background:
                linear-gradient(180deg, rgba(7, 10, 16, 0.78) 0%, rgba(7, 10, 16, 0.85) 55%, #070a10 100%),
                url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1920&q=85') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .container {
            max-width: 1340px;
            margin: 0 auto;
            padding: 0 24px;
            width: 100%;
        }

        header {
            padding: 28px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
        }

        .logo-icon {
            width: 46px;
            height: 46px;
            background: linear-gradient(135deg, var(--gold-dark), var(--gold));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #070a10;
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }

        .logo-text h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: #fff;
        }

        .logo-text h1 span {
            color: var(--gold);
        }

        .logo-text p {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--gold);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 11px 24px;
            border-radius: 11px;
            font-weight: 600;
            font-size: 0.92rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .btn-ghost {
            color: #e2e8f0;
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .btn-ghost:hover {
            border-color: var(--gold);
            color: var(--gold);
            transform: translateY(-2px);
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--gold-dark), var(--gold));
            color: #070a10;
            font-weight: 700;
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
        }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(212, 175, 55, 0.45);
        }

        .hero-body {
            padding: 90px 0 70px;
            text-align: center;
            max-width: 900px;
            margin: 0 auto;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(212, 175, 55, 0.14);
            border: 1px solid rgba(212, 175, 55, 0.35);
            color: var(--gold);
            padding: 7px 18px;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            margin-bottom: 24px;
        }

        .hero-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.6rem, 5.5vw, 4.5rem);
            font-weight: 700;
            line-height: 1.12;
            margin-bottom: 24px;
        }

        .hero-title span {
            color: var(--gold);
            font-style: italic;
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: #cbd5e1;
            line-height: 1.75;
            max-width: 680px;
            margin: 0 auto 42px;
        }

        .hero-cta-group {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 70px;
        }

        .btn-lg {
            padding: 15px 34px;
            font-size: 1rem;
            border-radius: 12px;
        }

        .stats-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 22px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 18px;
            padding: 26px 20px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: var(--gold);
        }

        .stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--gold);
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 0.88rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .showcase-section {
            padding: 90px 0;
            background: #0a0f1a;
            border-top: 1px solid rgba(212, 175, 55, 0.15);
        }

        .section-heading {
            text-align: center;
            margin-bottom: 56px;
        }

        .section-heading h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.6rem;
            margin-bottom: 12px;
        }

        .section-heading p {
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 28px;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 36px 30px;
            transition: all 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            border-color: rgba(212, 175, 55, 0.4);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .feature-icon {
            width: 58px;
            height: 58px;
            border-radius: 14px;
            background: rgba(212, 175, 55, 0.14);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 22px;
        }

        .feature-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            margin-bottom: 12px;
        }

        .feature-card p {
            color: var(--text-muted);
            line-height: 1.7;
            font-size: 0.95rem;
        }

        footer {
            padding: 36px 0;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.07);
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        @@media (max-width: 768px) {
            .nav-container {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="hero-backdrop">
        <header>
            <div class="container">
                <nav class="nav-container">
                    <a href="@Url.Action("Index", "Home")" class="logo">
                        <div class="logo-icon"><i class="fas fa-hotel"></i></div>
                        <div class="logo-text">
                            <h1>Bookify<span>Hotel</span></h1>
                            <p>Five-Star Sanctuary</p>
                        </div>
                    </a>
                    <div class="nav-actions">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-ghost">
                            <i class="fas fa-compass"></i> Explore Hotel
                        </a>
                        <a href="@Url.Action("Index", "Room")" class="btn btn-ghost">
                            <i class="fas fa-bed"></i> Our Suites
                        </a>
                        <a href="@Url.Action("Login", "Login")" class="btn btn-ghost">
                            <i class="fas fa-sign-in-alt"></i> Sign In
                        </a>
                        <a href="@Url.Action("Register", "Register")" class="btn btn-gold">
                            <i class="fas fa-user-plus"></i> Join Now
                        </a>
                    </div>
                </nav>
            </div>
        </header>

        <div class="container">
            <div class="hero-body">
                <div class="eyebrow">
                    <i class="fas fa-star"></i> Award-Winning Luxury Sanctuary
                </div>
                <h1 class="hero-title">
                    Where Timeless Elegance Meets <span>Unforgettable</span> Stays
                </h1>
                <p class="hero-subtitle">
                    Discover bespoke oceanfront suites, private butler service, and effortless online booking tailored for discerning travelers.
                </p>

                <div class="hero-cta-group">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-gold btn-lg">
                        <i class="fas fa-calendar-check"></i> Explore Rooms &amp; Book Now
                    </a>
                    <a href="@Url.Action("Login", "Login")" class="btn btn-ghost btn-lg">
                        <i class="fas fa-user-shield"></i> Member / Admin Sign In
                    </a>
                </div>

                <div class="stats-bar">
                    <div class="stat-card">
                        <div class="stat-number">12+</div>
                        <div class="stat-label">Curated Luxury Suites</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">24/7</div>
                        <div class="stat-label">Private Concierge</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">4.9 ★</div>
                        <div class="stat-label">Guest Satisfaction</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">100%</div>
                        <div class="stat-label">Instant Confirmation</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="showcase-section">
        <div class="container">
            <div class="section-heading">
                <div class="eyebrow">The Bookify Difference</div>
                <h2>Crafted for Discerning Guests</h2>
                <p>Every detail of your stay is designed around serenity, sophistication, and seamless convenience.</p>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-key"></i></div>
                    <h3>Instant Suite Reservation</h3>
                    <p>Browse live room availability by date, compare bespoke room categories, and lock in your reservation in seconds.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-spa"></i></div>
                    <h3>World-Class Amenities</h3>
                    <p>From panoramic rooftop infinity pools to Michelin-inspired dining and private airport transfers.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
                    <h3>Flexible &amp; Secure Checkout</h3>
                    <p>Pay securely online via Stripe or select Cash on Arrival with complimentary cancellation up to 24 hours before check-in.</p>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            &copy; @DateTime.Now.Year BookifyHotel Luxury Hospitality. All rights reserved.
        </div>
    </footer>
</body>
</html>
