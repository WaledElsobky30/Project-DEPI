@{
    ViewData["Title"] = "BookifyHotel - Luxury Hotel Management";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #0f172a;
            --secondary: #b8860b;
            --secondary-light: #d4af37;
            --accent: #1e293b;
            --text: #f8fafc;
            --text-secondary: #cbd5e1;
            --card-bg: rgba(255, 255, 255, 0.05);
            --glass-effect: rgba(255, 255, 255, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

            /* Background Pattern */
            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-image: radial-gradient(circle at 10% 20%, rgba(184, 134, 11, 0.1) 0%, transparent 20%), radial-gradient(circle at 90% 80%, rgba(212, 175, 55, 0.1) 0%, transparent 20%), radial-gradient(circle at 50% 50%, rgba(30, 41, 59, 0.3) 0%, transparent 50%);
                z-index: -1;
            }

        /* Container */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header */
        header {
            padding: 30px 0;
            position: relative;
            z-index: 100;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--secondary), var(--secondary-light));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .logo-text h1 {
            font-size: 2rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--secondary), var(--secondary-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .logo-text p {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .auth-buttons {
            display: flex;
            gap: 20px;
        }

        .btn {
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 2px solid transparent;
        }

        .btn-login {
            background: transparent;
            color: var(--text);
            border-color: var(--glass-effect);
        }

            .btn-login:hover {
                background: rgba(255, 255, 255, 0.05);
                border-color: var(--secondary);
                transform: translateY(-2px);
            }

        .btn-register {
            background: linear-gradient(135deg, var(--secondary), var(--secondary-light));
            color: white;
        }

            .btn-register:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(184, 134, 11, 0.3);
            }

        /* Hero Section */
        .hero {
            padding: 100px 0;
            position: relative;
            z-index: 10;
        }

        .hero-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 20px;
            line-height: 1.2;
        }

            .hero-title span {
                background: linear-gradient(135deg, var(--secondary), var(--secondary-light));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        .hero-subtitle {
            font-size: 1.3rem;
            color: var(--text-secondary);
            margin-bottom: 40px;
            line-height: 1.6;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-bottom: 60px;
        }

        .btn-hero {
            padding: 15px 40px;
            font-size: 1.1rem;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
            margin-top: 80px;
        }

        .stat-item {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-effect);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
        }

            .stat-item:hover {
                transform: translateY(-5px);
                border-color: var(--secondary);
            }

        .stat-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--secondary), var(--secondary-light));
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 24px;
            color: white;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--secondary);
        }

        .stat-text {
            color: var(--text-secondary);
            font-size: 1rem;
        }

        /* Features Section */
        .features {
            padding: 100px 0;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 40px;
            margin: 40px;
            position: relative;
            overflow: hidden;
        }

            .features::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: linear-gradient(90deg, transparent, var(--secondary), transparent);
            }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 60px;
            color: white;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            padding: 0 40px;
        }

        .feature-card {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-effect);
            border-radius: 15px;
            padding: 40px 30px;
            text-align: center;
            transition: all 0.3s ease;
        }

            .feature-card:hover {
                transform: translateY(-10px);
                border-color: var(--secondary);
                box-shadow: 0 15px 35px rgba(184, 134, 11, 0.1);
            }

        .feature-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--secondary), var(--secondary-light));
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            font-size: 32px;
            color: white;
        }

        .feature-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: white;
        }

        .feature-description {
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Footer */
        footer {
            padding: 60px 0 30px;
            text-align: center;
            border-top: 1px solid var(--glass-effect);
            margin-top: 60px;
        }

        .footer-logo {
            margin-bottom: 30px;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .footer-link {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .footer-link:hover {
                color: var(--secondary);
            }

        .copyright {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: 30px;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .hero-title

        {
            font-size: 2.5rem;
        }

        .hero-subtitle {
            font-size: 1.1rem;
        }

        .hero-buttons {
            flex-direction: column;
            align-items: center;
        }

        .btn-hero {
            width: 100%;
            max-width: 300px;
        }

        .features {
            margin: 20px;
        }

        .features-grid {
            padding: 0 20px;
        }

        .auth-buttons {
            gap: 10px;
        }

        .btn {
            padding: 10px 20px;
            font-size: 0.9rem;
        }

        .nav-container {
            flex-direction: column;
            gap: 20px;
        }

        }

        @@media (max-width: 576px) {
            .hero-title

        {
            font-size: 2rem;
        }

        .hero {
            padding: 60px 0;
        }

        .features {
            padding: 60px 0;
            margin: 10px;
        }

        .section-title {
            font-size: 2rem;
        }

        }

        /* Animations */
        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .hero-content,
        .feature-card,
        .stat-item {
            animation: fadeInUp 0.6s ease-out;
        }

            .feature-card:nth-child(2) {
                animation-delay: 0.2s;
            }

            .feature-card:nth-child(3) {
                animation-delay: 0.4s;
            }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container">
            <nav class="nav-container">
                <div class="logo">
                    <div class="logo-icon">
                        <i class="fas fa-hotel"></i>
                    </div>
                    <div class="logo-text">
                        <h1>BookifyHotel</h1>
                        <p>Luxury Hotel Management</p>
                    </div>
                </div>
                <div class="auth-buttons">
                    <a href="@Url.Action("Login", "Login")" class="btn btn-login">
                        <i class="fas fa-sign-in-alt"></i>
                        Login
                    </a>
                    <a href="@Url.Action("Register", "Register")" class="btn btn-register">
                        <i class="fas fa-user-plus"></i>
                        Register
                    </a>
                </div>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <main>
        <section class="hero">
            <div class="container">
                <div class="hero-content">
                    <h1 class="hero-title">
                        Experience <span>Luxury</span> Hospitality Management
                    </h1>
                    <p class="hero-subtitle">
                        Streamline your hotel operations with our comprehensive management system.
                        From booking to billing, we provide everything you need to deliver
                        exceptional guest experiences.
                    </p>

                    <div class="hero-buttons">
                        <a href="@Url.Action("Login", "Login")" class="btn btn-login btn-hero">
                            <i class="fas fa-sign-in-alt"></i>
                            Get Started
                        </a>
                        <a href="#features" class="btn btn-register btn-hero">
                            <i class="fas fa-play-circle"></i>
                            Watch Demo
                        </a>
                    </div>

                    <div class="stats">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-hotel"></i>
                            </div>
                            <div class="stat-number">500+</div>
                            <div class="stat-text">Hotels Managed</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div class="stat-number">50K+</div>
                            <div class="stat-text">Monthly Bookings</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-number">100K+</div>
                            <div class="stat-text">Happy Guests</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <div class="stat-number">99.8%</div>
                            <div class="stat-text">Satisfaction Rate</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="features" id="features">
            <div class="container">
                <h2 class="section-title">Why Choose BookifyHotel?</h2>

                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <h3 class="feature-title">Real-time Management</h3>
                        <p class="feature-description">
                            Manage bookings, rooms, and staff in real-time with our intuitive dashboard.
                            Get instant updates and notifications.
                        </p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                        <h3 class="feature-title">Smart Analytics</h3>
                        <p class="feature-description">
                            Advanced reporting and analytics to help you make data-driven decisions
                            for your hotel business.
                        </p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h3 class="feature-title">Secure & Reliable</h3>
                        <p class="feature-description">
                            Enterprise-grade security with 99.9% uptime. Your data is protected
                            with the highest standards.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-logo">
                <div class="logo">
                    <div class="logo-icon">
                        <i class="fas fa-hotel"></i>
                    </div>
                    <div class="logo-text">
                        <h1>BookifyHotel</h1>
                        <p>Redefining Hospitality</p>
                    </div>
                </div>
            </div>

            <div class="footer-links">
                <a href="#" class="footer-link">About Us</a>
                <a href="#" class="footer-link">Features</a>
                <a href="#" class="footer-link">Pricing</a>
                <a href="#" class="footer-link">Contact</a>
                <a href="#" class="footer-link">Privacy Policy</a>
                <a href="#" class="footer-link">Terms of Service</a>
            </div>

            <div class="copyright">
                <p>&copy; @DateTime.Now.Year BookifyHotel. All rights reserved.</p>
                <p style="margin-top: 10px; font-size: 0.8rem; color: #94a3b8;">
                    Designed with <i class="fas fa-heart" style="color: #ef4444;"></i> for hotel management excellence
                </p>
            </div>
        </div>
    </footer>

    <script>
        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add hover effect to cards
        document.querySelectorAll('.feature-card, .stat-item').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-10px)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // Add click effect to buttons
        document.querySelectorAll('.btn').forEach(button => {
            button.addEventListener('click', function() {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 150);
            });
        });

        // Animate stats on scroll
        const stats = document.querySelectorAll('.stat-number');
        const statsObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const statNumber = entry.target;
                    const targetValue = parseInt(statNumber.textContent);
                    let currentValue = 0;
                    const increment = targetValue / 50;
                    const timer = setInterval(() => {
                        currentValue += increment;
                        if (currentValue >= targetValue) {
                            statNumber.textContent = targetValue + (statNumber.textContent.includes('+') ? '+' :
                                                                    statNumber.textContent.includes('%') ? '%' : '');
                            clearInterval(timer);
                        } else {
                            statNumber.textContent = Math.floor(currentValue);
                        }
                    }, 30);
                    statsObserver.unobserve(statNumber);
                }
            });
        }, { threshold: 0.5 });

        stats.forEach(stat => statsObserver.observe(stat));

        // Update copyright year
        document.addEventListener('DOMContentLoaded', function() {
            const yearSpan = document.querySelector('.copyright p');
            if (yearSpan) {
                yearSpan.innerHTML = yearSpan.innerHTML.replace('@DateTime.Now.Year', new Date().getFullYear());
            }
        });
    </script>
</body>
</html>