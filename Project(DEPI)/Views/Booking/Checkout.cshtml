@{
    ViewData["Title"] = "Complete Your Reservation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .checkout-page {
        background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.08), transparent 45%),
                    linear-gradient(180deg, #07090e 0%, #0d111a 100%);
        min-height: 100vh;
        padding: 70px 24px 100px;
        color: #f8fafc;
    }

    .checkout-wrapper {
        max-width: 1180px;
        margin: 0 auto;
    }

    .checkout-header {
        text-align: center;
        margin-bottom: 44px;
    }

    .checkout-header h1 {
        font-family: var(--font-display, 'Playfair Display', serif);
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 10px;
    }

    .checkout-header p {
        color: #94a3b8;
        font-size: 1.05rem;
    }

    .checkout-grid {
        display: grid;
        grid-template-columns: 1.35fr 0.95fr;
        gap: 36px;
        align-items: start;
    }

    .checkout-card {
        background: rgba(17, 22, 34, 0.88);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 24px;
        padding: 36px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    }

    .card-section-title {
        font-family: var(--font-display, 'Playfair Display', serif);
        font-size: 1.4rem;
        color: #f8fafc;
        margin-bottom: 24px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-section-title i {
        color: #d4af37;
        font-size: 1.1rem;
    }

    .dates-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .form-label-luxury {
        display: block;
        color: #d4af37;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.4px;
        margin-bottom: 10px;
    }

    .form-input-luxury {
        width: 100%;
        padding: 14px 16px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        color: #f8fafc;
        font-size: 0.98rem;
        transition: all 0.25s ease;
        color-scheme: dark;
    }

    .form-input-luxury:focus {
        outline: none;
        border-color: #d4af37;
        background: rgba(255, 255, 255, 0.07);
        box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
    }

    /* Interactive Payment Method Selector */
    .payment-methods-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 28px;
    }

    .payment-option {
        position: relative;
        cursor: pointer;
    }

    .payment-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .payment-tile {
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.03);
        border-radius: 14px;
        padding: 18px 14px;
        text-align: center;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .payment-tile i {
        font-size: 1.45rem;
        color: #94a3b8;
        transition: color 0.25s ease;
    }

    .payment-tile span {
        font-size: 0.85rem;
        font-weight: 600;
        color: #cbd5e1;
    }

    .payment-option input:checked + .payment-tile {
        border-color: #d4af37;
        background: rgba(212, 175, 55, 0.12);
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
    }

    .payment-option input:checked + .payment-tile i,
    .payment-option input:checked + .payment-tile span {
        color: #d4af37;
    }

    .policy-box {
        background: rgba(212, 175, 55, 0.06);
        border: 1px solid rgba(212, 175, 55, 0.2);
        border-radius: 16px;
        padding: 18px 20px;
        margin-bottom: 26px;
    }

    .policy-box h5 {
        color: #d4af37;
        font-size: 0.88rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .policy-box ul {
        margin: 0;
        padding-left: 18px;
        color: #cbd5e1;
        font-size: 0.86rem;
        line-height: 1.7;
    }

    .btn-submit-booking {
        width: 100%;
        background: linear-gradient(135deg, #d4af37 0%, #aa8010 100%);
        color: #07090e;
        border: none;
        padding: 16px 24px;
        border-radius: 14px;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 12px 30px rgba(212, 175, 55, 0.3);
    }

    .btn-submit-booking:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 38px rgba(212, 175, 55, 0.45);
    }

    /* Summary Card */
    .summary-card {
        position: sticky;
        top: 105px;
        border-color: rgba(212, 175, 55, 0.28);
    }

    .summary-thumb {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 16px;
        margin-bottom: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .summary-suite-type {
        color: #d4af37;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .summary-room-no {
        font-family: var(--font-display, 'Playfair Display', serif);
        font-size: 1.65rem;
        color: #f8fafc;
        margin: 4px 0 20px;
    }

    .price-breakdown {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 18px;
    }

    .breakdown-row {
        display: flex;
        justify-content: space-between;
        color: #cbd5e1;
        font-size: 0.95rem;
        margin-bottom: 14px;
    }

    .breakdown-total {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: 18px;
        margin-top: 18px;
        font-weight: 700;
        font-size: 1.1rem;
        color: #f8fafc;
    }

    .total-highlight {
        font-family: var(--font-display, 'Playfair Display', serif);
        font-size: 1.85rem;
        color: #d4af37;
    }

    @@media (max-width: 992px) {
        .checkout-grid {
            grid-template-columns: 1fr;
        }
        .dates-row, .payment-methods-grid {
            grid-template-columns: 1fr;
        }
        .summary-card {
            position: static;
        }
    }
</style>

<section class="checkout-page">
    <div class="checkout-wrapper">

        <div class="checkout-header">
            <span class="section-eyebrow"><i class="fas fa-lock"></i> Secure Luxury Reservation</span>
            <h1>Confirm Your Stay</h1>
            <p>Complete your reservation details below for instant suite confirmation</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 16px 20px; border-radius: 14px; margin-bottom: 28px; display: flex; align-items: center; gap: 12px;">
                <i class="fas fa-circle-exclamation" style="font-size: 1.2rem;"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        <div class="checkout-grid">

            <!-- Left Column: Reservation Form -->
            <div class="checkout-card">
                <h3 class="card-section-title">
                    <i class="fas fa-calendar-alt"></i> Stay & Payment Details
                </h3>

                <form asp-action="ConfirmBooking" asp-controller="Booking" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="roomId" value="@ViewBag.RoomId" />

                    <div class="dates-row">
                        <div>
                            <label class="form-label-luxury" for="checkIn">
                                <i class="fas fa-plane-arrival me-1"></i> Check-In Date
                            </label>
                            <input type="date" name="checkIn" id="checkIn" class="form-input-luxury" required />
                        </div>

                        <div>
                            <label class="form-label-luxury" for="checkOut">
                                <i class="fas fa-plane-departure me-1"></i> Check-Out Date
                            </label>
                            <input type="date" name="checkOut" id="checkOut" class="form-input-luxury" required />
                        </div>
                    </div>

                    <label class="form-label-luxury">
                        <i class="fas fa-credit-card me-1"></i> Preferred Payment Method
                    </label>
                    <div class="payment-methods-grid">
                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="Credit Card" checked />
                            <div class="payment-tile">
                                <i class="fas fa-credit-card"></i>
                                <span>Credit Card</span>
                            </div>
                        </label>
                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="PayPal" />
                            <div class="payment-tile">
                                <i class="fab fa-paypal"></i>
                                <span>PayPal</span>
                            </div>
                        </label>
                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="Cash" />
                            <div class="payment-tile">
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Pay on Arrival</span>
                            </div>
                        </label>
                    </div>

                    <div class="policy-box">
                        <h5><i class="fas fa-shield-halved"></i> Bookify Luxury Guarantee & Policies</h5>
                        <ul>
                            <li>Check-in begins at 2:00 PM · Express late check-out until 12:00 PM</li>
                            <li>Complimentary cancellation up to 24 hours prior to arrival</li>
                            <li>No hidden resort fees — taxes and welcome amenities included</li>
                        </ul>
                    </div>

                    <button type="submit" class="btn-submit-booking">
                        <span>Confirm & Complete Reservation</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
            </div>

            <!-- Right Column: Suite Summary -->
            <aside class="checkout-card summary-card">
                <h3 class="card-section-title">
                    <i class="fas fa-concierge-bell"></i> Reservation Summary
                </h3>

                <img src="@(string.IsNullOrEmpty(ViewBag.ImageUrl) ? "https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=900&q=80" : ViewBag.ImageUrl)"
                     class="summary-thumb" alt="Suite Preview" />

                <div class="summary-suite-type">@ViewBag.RoomType</div>
                <div class="summary-room-no">Suite #@ViewBag.RoomNumber</div>

                <div class="price-breakdown">
                    <div class="breakdown-row">
                        <span>Nightly Rate</span>
                        <strong>$@ViewBag.PricePerNight</strong>
                    </div>
                    <div class="breakdown-row">
                        <span>Duration</span>
                        <span><strong id="displayNights">1</strong> Night(s)</span>
                    </div>
                    <div class="breakdown-row">
                        <span>Luxury Taxes & Service</span>
                        <span style="color: #10b981;">Included</span>
                    </div>
                    <div class="breakdown-total">
                        <span>Total Amount</span>
                        <span class="total-highlight">$<span id="displayTotal">@ViewBag.PricePerNight</span></span>
                    </div>
                </div>
            </aside>

        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const pricePerNight = parseFloat('@ViewBag.PricePerNight') || 0;
        const checkInInput = document.getElementById('checkIn');
        const checkOutInput = document.getElementById('checkOut');
        const displayNights = document.getElementById('displayNights');
        const displayTotal = document.getElementById('displayTotal');

        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);

        const formatDate = (d) => d.toISOString().split('T')[0];

        checkInInput.min = formatDate(today);
        checkInInput.value = formatDate(today);

        checkOutInput.min = formatDate(tomorrow);
        checkOutInput.value = formatDate(tomorrow);

        function calculateTotal() {
            const d1 = new Date(checkInInput.value);
            const d2 = new Date(checkOutInput.value);

            if (checkInInput.value && checkOutInput.value && d2 > d1) {
                const days = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24));
                displayNights.innerText = days;
                displayTotal.innerText = (days * pricePerNight).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            } else {
                displayNights.innerText = '0';
                displayTotal.innerText = '0.00';
            }
        }

        checkInInput.addEventListener('change', function () {
            const selectedIn = new Date(this.value);
            const minOut = new Date(selectedIn);
            minOut.setDate(minOut.getDate() + 1);
            checkOutInput.min = formatDate(minOut);
            if (new Date(checkOutInput.value) <= selectedIn) {
                checkOutInput.value = formatDate(minOut);
            }
            calculateTotal();
        });

        checkOutInput.addEventListener('change', calculateTotal);
        calculateTotal();
    });
</script>
