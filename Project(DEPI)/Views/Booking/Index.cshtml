@using BookifyHotel.Model
@model List<Booking>
@{
    ViewData["Title"] = "Bookings Management";
    Layout = "~/Views/Shared/_SideBarLayout.cshtml";
}

<body data-active-page="bookings">
    <div class="header">
        <h2>Bookings Management</h2>
        <div class="user-info">
            <div>
                <h4>System Administrator</h4>
                <p style="color: #b8860b;">Admin</p>
            </div>
            <img src="https://ui-avatars.com/api/?name=Admin&background=b8860b&color=fff" alt="User">
        </div>
    </div>

    <!-- Page Actions -->
    <div class="page-actions">
        <div class="filters-section">
            <div class="search-box">
                <input type="text" placeholder="Search bookings...">
                <i class="fas fa-search"></i>
            </div>
            <select class="filter-select" id="statusFilter">
                <option value="">All Status</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Pending">Pending</option>
                <option value="Cancelled">Cancelled</option>
                <option value="Completed">Completed</option>
            </select>
            <input type="date" class="filter-date" id="dateFilter" placeholder="Filter by date">
        </div>
        <button class="add-btn" onclick="location.href='@Url.Action("Create", "Booking")'">
            <i class="fas fa-plus"></i>
            New Booking
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-icon total-bookings">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count</h3>
                <p>Total Bookings</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon confirmed">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(b => b.Status == "Confirmed")</h3>
                <p>Confirmed</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon pending">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(b => b.Status == "Pending")</h3>
                <p>Pending</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon revenue">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="stat-info">
                @{
                    var totalRevenue = Model
                    .Where(b => b.Status == "Confirmed" || b.Status == "Completed")
                    .Sum(b => CalculateTotalPrice(b));
                }
                <h3>$@totalRevenue.ToString("N0")</h3>
                <p>Total Revenue</p>
            </div>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="table-container">
        <div class="table-header">
            <h3>All Bookings</h3>
            <span class="total-items">Showing @Model.Count bookings</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>BOOKING ID</th>
                        <th>GUEST</th>
                        <th>ROOM</th>
                        <th>DATES</th>
                        <th>NIGHTS</th>
                        <th>PRICE/NIGHT</th>
                        <th>TOTAL PRICE</th>
                        <th>STATUS</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        var nights = (booking.CheckOutDate - booking.CheckInDate).Days;
                        var pricePerNight = booking.Room?.RoomTypes?.PricePerNight ?? 0;
                        var calculatedTotalPrice = nights * pricePerNight;

                        <tr>
                            <td>
                                <strong>BK@(booking.BookingId.ToString("D4"))</strong>
                            </td>
                            <td>
                                <div class="guest-info">
                                    <strong>@booking.UserProfile?.FullName </strong>
                                    <div style="font-size: 12px; color: #ccc;">@booking.UserProfile?.Email</div>
                                </div>
                            </td>
                            <td>
                                <div class="room-info">
                                    <strong>Room @booking.Room?.RoomNumber</strong>
                                    <div style="font-size: 12px; color: #ccc;">@booking.Room?.RoomTypes?.Name</div>
                                </div>
                            </td>
                            <td>
                                <div class="dates-info">
                                    <div class="date-item">
                                        <div class="date-label">Check-in</div>
                                        <div class="date-value">@booking.CheckInDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                    <div class="date-item">
                                        <div class="date-label">Check-out</div>
                                        <div class="date-value">@booking.CheckOutDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="nights-count">
                                    <strong>@nights</strong>
                                    <div style="font-size: 12px; color: #ccc;">nights</div>
                                </div>
                            </td>
                            <td>
                                <div class="price-per-night">
                                    <strong>$@pricePerNight.ToString("N2")</strong>
                                    <div style="font-size: 12px; color: #ccc;">per night</div>
                                </div>
                            </td>
                            <td>
                                <div class="price-info">
                                    <strong>$@calculatedTotalPrice.ToString("N2")</strong>
                                </div>
                            </td>
                            <td>
                                <span class="status @booking.Status.ToLower()">@booking.Status</span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="action-btn view-btn" onclick="location.href='@Url.Action("Details", "Booking", new { id = booking.BookingId })'">
                                        <i class="fas fa-eye"></i>
                                        View
                                    </button>
                                    <button class="action-btn edit-btn" onclick="location.href='@Url.Action("Edit", "Booking", new { id = booking.BookingId })'">
                                        <i class="fas fa-edit"></i>
                                        Edit
                                    </button>
                                    <button class="action-btn delete-btn" onclick="location.href='@Url.Action("Delete", "Booking", new { id = booking.BookingId })'">
                                        <i class="fas fa-trash"></i>
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-calendar-times"></i>
                <h3>No Bookings Found</h3>
                <p>No bookings have been made yet. Start by creating a new booking.</p>
                <button class="add-btn" onclick="location.href='@Url.Action("Create", "Booking")'" style="margin-top: 20px;">
                    <i class="fas fa-plus"></i>
                    Create First Booking
                </button>
            </div>
        }
    </div>

    <style>
        /* Page Actions */
        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            gap: 20px;
        }

        .filters-section {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            width: 250px;
        }

            .search-box input {
                width: 100%;
                padding: 12px 20px 12px 45px;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                color: white;
                font-size: 14px;
                backdrop-filter: blur(10px);
            }

                .search-box input:focus {
                    outline: none;
                    border-color: var(--secondary);
                }

            .search-box i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--secondary);
            }

        .filter-select, .filter-date {
            padding: 12px 15px;
            background: black;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: white;
            font-size: 14px;
            backdrop-filter: blur(10px);
            cursor: pointer;
        }

            .filter-select:focus, .filter-date:focus {
                outline: none;
                border-color: var(--secondary);
            }

        .add-btn {
            background: linear-gradient(135deg, var(--secondary), var(--accent));
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
            white-space: nowrap;
        }

            .add-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(184, 134, 11, 0.4);
            }

        /* Stats Cards */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: all 0.3s;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .stat-card:hover {
                transform: translateY(-5px);
                border-color: rgba(184, 134, 11, 0.3);
            }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .total-bookings {
            background: linear-gradient(135deg, #3b82f6, #60a5fa);
        }

        .confirmed {
            background: linear-gradient(135deg, #10b981, #34d399);
        }

        .pending {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
        }

        .revenue {
            background: linear-gradient(135deg, #8b5cf6, #a78bfa);
        }

        .stat-info h3 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 5px;
            color: white;
        }

        .stat-info p {
            color: #ccc;
            font-size: 14px;
        }

        /* Table Container */
        .table-container {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

            .table-header h3 {
                color: white;
                font-weight: 600;
                font-size: 1.5rem;
            }

        .total-items {
            color: var(--secondary);
            font-weight: 600;
            background: rgba(184, 134, 11, 0.1);
            padding: 8px 15px;
            border-radius: 10px;
            border: 1px solid rgba(184, 134, 11, 0.2);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 15px 12px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        th {
            background-color: rgba(0, 0, 0, 0.3);
            color: var(--secondary);
            font-weight: 600;
            font-size: 13px;
        }

        tr:hover {
            background-color: rgba(184, 134, 11, 0.05);
        }

        /* Guest & Room Info */
        .guest-info, .room-info {
            font-weight: 600;
            color: white;
        }

        .dates-info {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .date-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .date-label {
            color: #ccc;
            font-size: 11px;
            min-width: 60px;
        }

        .date-value {
            color: white;
            font-size: 12px;
            font-weight: 500;
        }

        .nights-count, .price-per-night, .price-info {
            text-align: center;
        }

            .nights-count strong, .price-per-night strong, .price-info strong {
                color: white;
                font-size: 14px;
            }

        /* Status Styles */
        .status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .confirmed {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .pending {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .cancelled {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        .completed {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 6px;
        }

        .action-btn {
            padding: 6px 10px;
            border: none;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }

        .view-btn {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

            .view-btn:hover {
                background: rgba(16, 185, 129, 0.3);
            }

        .edit-btn {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

            .edit-btn:hover {
                background: rgba(59, 130, 246, 0.3);
            }

        .delete-btn {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

            .delete-btn:hover {
                background: rgba(239, 68, 68, 0.3);
            }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #ccc;
        }

            .empty-state i {
                font-size: 64px;
                color: var(--secondary);
                margin-bottom: 20px;
                opacity: 0.5;
            }

            .empty-state h3 {
                font-size: 24px;
                margin-bottom: 10px;
                color: white;
            }

            .empty-state p {
                margin-bottom: 20px;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .page-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .filters-section {
                justify-content: center;
            }

            .search-box {
                width: 100%;
            }

            .table-container {
                overflow-x: auto;
            }

            table {
                min-width: 1200px;
            }

            .stats-container {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 576px) {
            .stats-container {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .filters-section {
                flex-direction: column;
            }

            .filter-select, .filter-date {
                width: 100%;
            }
        }
    </style>

    <script>
        // Confirm delete function
        function confirmDelete(bookingId, bookingCode) {
            if (confirm(`Are you sure you want to delete booking ${bookingCode}? This action cannot be undone.`)) {
                window.location.href = '@Url.Action("Delete", "Booking")' + '?id=' + bookingId;
            }
        }

        // Search functionality
        document.querySelector('.search-box input').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const tableRows = document.querySelectorAll('tbody tr');

            tableRows.forEach(row => {
                const guestName = row.querySelector('.guest-info strong').textContent.toLowerCase();
                const roomNumber = row.querySelector('.room-info strong').textContent.toLowerCase();
                const bookingId = row.querySelector('td:first-child strong').textContent.toLowerCase();

                if (guestName.includes(searchTerm) || roomNumber.includes(searchTerm) || bookingId.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Status filter
        document.getElementById('statusFilter').addEventListener('change', function() {
            const status = this.value;
            const tableRows = document.querySelectorAll('tbody tr');

            tableRows.forEach(row => {
                const rowStatus = row.querySelector('.status').textContent;
                if (status === '' || rowStatus === status) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Date filter
        document.getElementById('dateFilter').addEventListener('change', function() {
            const selectedDate = this.value;
            if (!selectedDate) return;

            const tableRows = document.querySelectorAll('tbody tr');
            const filterDate = new Date(selectedDate);

            tableRows.forEach(row => {
                const checkInText = row.querySelector('.date-item:first-child .date-value').textContent;
                const checkInDate = new Date(checkInText);

                if (checkInDate.toDateString() === filterDate.toDateString()) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Add hover effect to table rows
        document.querySelectorAll('tbody tr').forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.backgroundColor = 'rgba(184, 134, 11, 0.05)';
            });

            row.addEventListener('mouseleave', function() {
                this.style.backgroundColor = '';
            });
        });
    </script>
</body>

@functions {
    // Function to calculate total price based on nights and room price
    private decimal CalculateTotalPrice(Booking booking)
    {
        if (booking.Room?.RoomTypes?.PricePerNight == null)
            return 0;

        var nights = (booking.CheckOutDate - booking.CheckInDate).Days;
        return nights * booking.Room.RoomTypes.PricePerNight;
    }
}