@* Views/Shared/_Footer.cshtml *@

<style>
    .luxury-footer {
        background: #05070b;
        color: #cbd5e1;
        padding: 80px 0 30px;
        border-top: 1px solid rgba(212, 175, 55, 0.2);
        margin-top: auto;
    }

    .luxury-footer .footer-content {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
        gap: 48px;
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .luxury-footer .brand-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .luxury-footer .brand-title span {
        color: #d4af37;
    }

    .luxury-footer .brand-desc {
        color: #94a3b8;
        line-height: 1.7;
        font-size: 0.94rem;
        margin-bottom: 24px;
    }

    .luxury-footer .footer-section h3 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #d4af37;
        margin-bottom: 22px;
    }

    .luxury-footer .footer-links ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .luxury-footer .footer-links li {
        margin-bottom: 12px;
    }

    .luxury-footer .footer-links a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.94rem;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .luxury-footer .footer-links a:hover {
        color: #d4af37;
        transform: translateX(4px);
    }

    .luxury-footer .contact-info p {
        margin-bottom: 14px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        color: #94a3b8;
        font-size: 0.93rem;
    }

    .luxury-footer .contact-info i {
        color: #d4af37;
        margin-top: 4px;
    }

    .luxury-footer .social-icons {
        display: flex;
        gap: 12px;
    }

    .luxury-footer .social-icons a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e2e8f0;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.25s ease;
    }

    .luxury-footer .social-icons a:hover {
        background: linear-gradient(135deg, #b8860b, #d4af37);
        color: #090d16;
        border-color: transparent;
        transform: translateY(-3px);
    }

    .luxury-footer .copyright {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 60px;
        padding: 24px 24px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        max-width: 1320px;
        margin-left: auto;
        margin-right: auto;
        color: #64748b;
        font-size: 0.86rem;
    }

    @@media (max-width: 992px) {
        .luxury-footer .footer-content {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 576px) {
        .luxury-footer .footer-content {
            grid-template-columns: 1fr;
        }
    }
</style>

<footer class="luxury-footer">
    <div class="footer-content">
        <div class="footer-section">
            <div class="brand-title">
                <i class="fas fa-hotel" style="color: #d4af37;"></i>
                Bookify<span>Hotel</span>
            </div>
            <p class="brand-desc">
                Where timeless architectural elegance meets bespoke modern comfort. Experience curated suites, fine dining, and world-class hospitality.
            </p>
            <div class="social-icons">
                <a href="https://facebook.com" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="https://instagram.com" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="https://twitter.com" target="_blank" aria-label="Twitter"><i class="fab fa-x-twitter"></i></a>
                <a href="https://linkedin.com" target="_blank" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            </div>
        </div>

        <div class="footer-section footer-links">
            <h3>Explore</h3>
            <ul>
                <li><a href="/Home/Index"><i class="fas fa-angle-right"></i> Home</a></li>
                <li><a href="/Room/Index"><i class="fas fa-angle-right"></i> Rooms &amp; Suites</a></li>
                <li><a href="/About/Index"><i class="fas fa-angle-right"></i> Our Story</a></li>
                <li><a href="/Booking/MyBookings"><i class="fas fa-angle-right"></i> Manage Reservations</a></li>
            </ul>
        </div>

        <div class="footer-section footer-links">
            <h3>Signature Suites</h3>
            <ul>
                <li><a href="/Room/Index"><i class="fas fa-angle-right"></i> Standard City Room</a></li>
                <li><a href="/Room/Index"><i class="fas fa-angle-right"></i> Deluxe Ocean View</a></li>
                <li><a href="/Room/Index"><i class="fas fa-angle-right"></i> Executive Junior Suite</a></li>
                <li><a href="/Room/Index"><i class="fas fa-angle-right"></i> Royal Presidential Suite</a></li>
            </ul>
        </div>

        <div class="footer-section contact-info">
            <h3>Private Concierge</h3>
            <p><i class="fas fa-map-marker-alt"></i> 742 Grand Corniche Boulevard, Luxury District</p>
            <p><i class="fas fa-phone-alt"></i> +1 (555) 123-4567</p>
            <p><i class="fas fa-envelope"></i> concierge@bookifyhotel.com</p>
            <p><i class="fas fa-clock"></i> Front Desk &amp; Butler Service: 24/7</p>
        </div>
    </div>

    <div class="copyright">
        <div>&copy; @DateTime.Now.Year BookifyHotel Luxury Hospitality. All rights reserved.</div>
        <div>Crafted for Extraordinary Stays</div>
    </div>
</footer>
