@using BookifyHotel.Controllers
@using BookifyHotel.Model
 @using Project_DEPI_.Controllers 
@model BookingViewModel

@{
    ViewData["Title"] = "Book Room";
    var room = ViewData["Room"] as Room;
}

<style>
    .booking-page {
        background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
        min-height: 100vh;
        padding: 100px 20px 50px;
    }

    .booking-container {
        max-width: 800px;
        margin: 0 auto;
    }

    /* Breadcrumb */
    .breadcrumb {
        display: flex;
        align-items: center;
        margin-bottom: 40px;
        color: #ccc;
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: #b8860b;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .breadcrumb a:hover {
        color: #ffd700;
    }

    .breadcrumb span {
        margin: 0 10px;
        color: #666;
    }

    /* Booking Card */
    .booking-card {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        padding: 40px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .booking-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .booking-title {
        font-size: 2rem;
        font-weight: 300;
        margin-bottom: 10px;
        background: linear-gradient(45deg, #b8860b, #ffd700);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .booking-subtitle {
        color: #ccc;
        font-size: 1.1rem;
        margin-bottom: 20px;
    }

    /* Room Info */
    .room-info-box {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        border-left: 4px solid #b8860b;
    }

    .room-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    @@media (max-width: 768px) {
        .room-info-grid {
            grid-template-columns: 1fr;
        }
    }

    .info-item {
        display: flex;
        align-items: center;
        color: #ccc;
    }

    .info-label {
        font-weight: 600;
        color: #b8860b;
        margin-right: 10px;
        min-width: 120px;
    }

    .price-display {
        background: rgba(184, 134, 11, 0.1);
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        margin: 20px 0;
        border: 1px solid rgba(184, 134, 11, 0.3);
    }

    .price-title {
        color: #ccc;
        font-size: 1rem;
        margin-bottom: 5px;
    }

    .price-amount {
        font-size: 2.5rem;
        color: #b8860b;
        font-weight: 300;
    }

    /* Form Styles */
    .form-section {
        margin-bottom: 35px;
    }

    .section-title {
        color: white;
        font-size: 1.3rem;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        color: #ccc;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #b8860b;
        box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.2);
        background: rgba(255, 255, 255, 0.12);
    }

    .date-inputs {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    @@media (max-width: 576px) {
        .date-inputs {
            grid-template-columns: 1fr;
        }
    }

    /* Calendar Info */
    .calendar-info {
        background: rgba(59, 130, 246, 0.1);
        border-radius: 10px;
        padding: 15px;
        margin: 15px 0;
        border-left: 4px solid #3b82f6;
        font-size: 0.9rem;
        color: #93c5fd;
    }

    .info-icon {
        margin-right: 8px;
    }

    /* Price Summary */
    .price-summary {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        padding: 25px;
        margin: 30px 0;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        color: #ccc;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .summary-row.total {
        border-top: 2px solid #b8860b;
        border-bottom: none;
        font-size: 1.3rem;
        color: white;
        margin-top: 10px;
        padding-top: 20px;
    }

    .summary-label {
        color: #ccc;
    }

    .summary-value {
        font-weight: 600;
        color: #b8860b;
    }

    .total .summary-value {
        color: #ffd700;
        font-size: 1.5rem;
    }

    /* Buttons */
    .booking-actions {
        display: flex;
        gap: 20px;
        margin-top: 40px;
    }

    @@media (max-width: 576px) {
        .booking-actions {
            flex-direction: column;
        }
    }

    .booking-btn {
        flex: 1;
        padding: 18px 30px;
        border-radius: 10px;
        text-decoration: none;
        text-align: center;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #b8860b, #d4af37);
        color: white;
        box-shadow: 0 5px 20px rgba(184, 134, 11, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(184, 134, 11, 0.4);
    }

    .btn-secondary {
        background: transparent;
        color: #b8860b;
        border: 2px solid #b8860b;
    }

    .btn-secondary:hover {
        background: #b8860b;
        color: white;
        transform: translateY(-3px);
    }

    /* Validation */
    .validation-summary {
        background: rgba(239, 68, 68, 0.1);
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 30px;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .text-danger {
        color: #f87171 !important;
        font-size: 0.9rem;
        margin-top: 5px;
        display: block;
    }

    /* Animation */
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .booking-card {
        animation: fadeIn 0.5s ease-out;
    }
</style>

<section class="booking-page">
    <div class="booking-container">
        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Home")">Home</a>
            <span>/</span>
            <a href="@Url.Action("Index", "Room")">Rooms</a>
            <span>/</span>
            <a href="@Url.Action("Details", "Room", new { id = Model.RoomId })">Room @Model.RoomNumber</a>
            <span>/</span>
            <span>Booking</span>
        </div>

        <!-- Booking Card -->
        <div class="booking-card">
            <!-- Header -->
            <div class="booking-header">
                <h1 class="booking-title">Book Your Stay</h1>
                <p class="booking-subtitle">Complete your reservation for Room @Model.RoomNumber</p>
            </div>

            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <!-- Room Info -->
            <div class="room-info-box">
                <h3 style="color: white; margin-bottom: 20px;">Room Information</h3>
                <div class="room-info-grid">
                    <div class="info-item">
                        <span class="info-label">Room Number:</span>
                        <span>@Model.RoomNumber</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Room Type:</span>
                        <span>@Model.RoomType</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Price per Night:</span>
                        <span>$@Model.PricePerNight.ToString("N0")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Max Guests:</span>
                        <span>@Model.MaxGuests</span>
                    </div>
                </div>
            </div>

            <!-- Booking Form -->
            <form asp-action="Book" method="post" id="bookingForm">
                <input type="hidden" asp-for="RoomId" />
                <input type="hidden" asp-for="RoomNumber" />
                <input type="hidden" asp-for="RoomType" />
                <input type="hidden" asp-for="PricePerNight" />
                <input type="hidden" asp-for="MaxGuests" />

                <!-- Dates Section -->
                <div class="form-section">
                    <h3 class="section-title">Select Dates</h3>

                    <div class="date-inputs">
                        <div class="form-group">
                            <label class="form-label" asp-for="CheckInDate">Check-in Date</label>
                            <input asp-for="CheckInDate"
                                   type="date"
                                   class="form-control"
                                   min="@Model.MinCheckInDate.ToString("yyyy-MM-dd")"
                                   max="@Model.MaxCheckOutDate.ToString("yyyy-MM-dd")"
                                   required />
                            <span asp-validation-for="CheckInDate" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label" asp-for="CheckOutDate">Check-out Date</label>
                            <input asp-for="CheckOutDate"
                                   type="date"
                                   class="form-control"
                                   min="@Model.MinCheckInDate.ToString("yyyy-MM-dd")"
                                   max="@Model.MaxCheckOutDate.ToString("yyyy-MM-dd")"
                                   required />
                            <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="calendar-info">
                        <i class="fas fa-info-circle info-icon"></i>
                        Check-in: After 3:00 PM | Check-out: Before 11:00 AM
                    </div>
                </div>

                <!-- Guests Section -->
                <div class="form-section">
                    <h3 class="section-title">Guest Information</h3>

                    <div class="form-group">
                        <label class="form-label" asp-for="NumberOfGuests">Number of Guests</label>
                        <input asp-for="NumberOfGuests"
                               type="number"
                               class="form-control"
                               min="1"
                               max="@Model.MaxGuests"
                               value="1"
                               required />
                        <span asp-validation-for="NumberOfGuests" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="SpecialRequests">Special Requests (Optional)</label>
                        <textarea asp-for="SpecialRequests"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Any special requirements or requests..."></textarea>
                    </div>
                </div>

                <!-- Price Summary -->
                <div class="price-summary" id="priceSummary" style="display: none;">
                    <h3 style="color: white; margin-bottom: 20px;">Price Summary</h3>

                    <div class="summary-row">
                        <span class="summary-label">Price per Night:</span>
                        <span class="summary-value">$<span id="pricePerNight">@Model.PricePerNight.ToString("N0")</span></span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Number of Nights:</span>
                        <span class="summary-value" id="nightsCount">0</span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Total Price:</span>
                        <span class="summary-value">$<span id="totalPrice">0</span></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="booking-actions">
                    <button type="submit" class="booking-btn btn-primary">
                        <i class="fas fa-check-circle"></i>
                        Confirm Booking
                    </button>
                    <a href="@Url.Action("Details", "Room", new { id = Model.RoomId })" class="booking-btn btn-secondary">
                        <i class="fas fa-arrow-left"></i>
                        Back to Room
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            // حساب السعر عند تغيير التواريخ
            function calculatePrice() {
                const checkIn = new Date($('#CheckInDate').val());
                const checkOut = new Date($('#CheckOutDate').val());
                const pricePerNight = @Model.PricePerNight;

                if (checkIn && checkOut && checkOut > checkIn) {
                    const nights = Math.floor((checkOut - checkIn) / (1000 * 60 * 60 * 24));
                    const totalPrice = nights * pricePerNight;

                    if (nights > 0 && nights <= 90) {
                        $('#nightsCount').text(nights);
                        $('#totalPrice').text(totalPrice.toLocaleString());
                        $('#priceSummary').fadeIn();
                    } else {
                        $('#priceSummary').fadeOut();
                    }
                } else {
                    $('#priceSummary').fadeOut();
                }
            }

            // إضافة الحد الأدنى لتاريخ الخروج
            $('#CheckInDate').on('change', function () {
                const checkInDate = new Date(this.value);
                const minCheckOut = new Date(checkInDate);
                minCheckOut.setDate(minCheckOut.getDate() + 1);

                $('#CheckOutDate').attr('min', minCheckOut.toISOString().split('T')[0]);

                // إذا كان تاريخ الخروج أقل من الجديد، نحدثه
                const currentCheckOut = new Date($('#CheckOutDate').val());
                if (currentCheckOut <= checkInDate) {
                    $('#CheckOutDate').val(minCheckOut.toISOString().split('T')[0]);
                }

                calculatePrice();
            });

            $('#CheckOutDate').on('change', calculatePrice);
            $('#NumberOfGuests').on('change', function () {
                const maxGuests = @Model.MaxGuests;
                if (this.value > maxGuests) {
                    this.value = maxGuests;
                    alert(`Maximum guests for this room is ${maxGuests}`);
                }
            });

            // منع التواريخ الماضية
            const today = new Date();
            today.setDate(today.getDate() + 1); // الغد كحد أدنى
            const minDate = today.toISOString().split('T')[0];

            $('#CheckInDate').attr('min', minDate);
            $('#CheckOutDate').attr('min', minDate);

            // تفعيل حساب السعر أول مرة إذا كانت التواريخ محددة
            if ($('#CheckInDate').val() && $('#CheckOutDate').val()) {
                calculatePrice();
            }
        });
    </script>
}